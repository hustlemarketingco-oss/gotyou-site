---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Download" description="Get paid for showing up! Download the free GOTYOU app and check out our daily deals at 11:23am.">
  <div class="page-hero">
    <div class="eyebrow" style="justify-content: center;">
      <span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
      Free Download
    </div>
    <h1>Get paid for showing up!</h1>
    <p class="lede">Check out our daily deals at 11:23am.</p>
    <h2 style="font-family: var(--font-display); font-size: 22px; margin-top: 1.5rem; position: relative; z-index: 1;">Check in. Share. Cash Out!</h2>
    <div class="app-store-row">
      <a href="https://apps.apple.com/us/app/gotyou-connect-earn/id6449746388" class="app-store-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: var(--yellow);"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8.99-.04 1.93-.71 3.27-.81 1.57.13 2.78.84 3.55 2.06-3.21 1.92-2.45 6.13.47 7.5-.5 1.49-1.27 2.71-2.37 3.42zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" /></svg>
        <div><span class="s">Download for</span><span class="b">iOS</span></div>
      </a>
      <a href="https://play.google.com/store/apps/details?id=com.gotyou.mobile" class="app-store-btn">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" style="color: var(--yellow);"><path d="M3 4.5c0-.5.27-.94.69-1.18l9.92 8.68-9.92 8.68A1.34 1.34 0 013 19.5v-15zm12.45 7.5l2.78-2.43 3.36 1.93c.6.34.6 1.16 0 1.5l-3.36 1.93-2.78-2.43v-.5zm-1.4 1.22l-9.43 8.25 9.55-5.5 1.78-1.56-1.9-1.66zm0-2.44l1.9-1.66-1.78-1.55-9.55-5.5 9.43 8.25z" /></svg>
        <div><span class="s">Download for</span><span class="b">Android</span></div>
      </a>
    </div>
  </div>
</BaseLayout>
