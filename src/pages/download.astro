---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import StoreBadges from '../components/StoreBadges.astro';
import DropCountdown from '../components/DropCountdown.astro';
import Phone from '../components/Phone.astro';
---

<BaseLayout title="Download the app" description="Get paid for showing up. Download GOTYOU free — something new drops every day at 11:23.">
  <section class="dl sky">
    <div class="container dl-grid">
      <div class="copy">
        <span class="eyebrow eyebrow--pill"><span class="dot"></span>Free on iPhone & Android</span>
        <h1 class="display">Get paid for <span class="hl-lime">showing up.</span></h1>
        <p class="lede">Something new drops every day at 11:23. Download GOTYOU free and start today.</p>
        <StoreBadges size="lg" />
        <div class="next">
          <span>Next drop in</span>
          <DropCountdown />
        </div>
      </div>
      <!-- Three real app screens fanned out (Drop, Explore, Wallet) with the rewards they lead to floating on top. -->
      <div class="art" role="img" aria-label="The GOTYOU app: the 11:23 Daily Drop, a live map of local spots, and a wallet of lifetime value unlocked">
        <span class="glow" aria-hidden="true"></span>
        <div class="fan fan--left float float--slow"><Phone src="/images/app/drop.webp" alt="" width={230} tilt={-9} eager /></div>
        <div class="fan fan--right float float--slow"><img src="/images/site/mockup-wallet-750.webp" alt="" class="wallet" width="750" height="1582" fetchpriority="high" /></div>
        <div class="fan fan--center float"><Phone src="/images/app/explore-map.webp" alt="" width={270} eager /></div>
        <div class="pop pop--cash" aria-hidden="true">
          <span class="pop-icon pop-icon--purple"><i class="ti ti-wallet"></i></span>
          <span><strong>$623.21</strong><small>Lifetime value unlocked</small></span>
        </div>
        <div class="pop pop--earn" aria-hidden="true">
          <span class="pop-icon pop-icon--green">$5</span>
          <span><strong>$5.00 Cash Back</strong><small>Pier 49 Pizza · $14.23 spend</small></span>
        </div>
        <div class="pop pop--drop" aria-hidden="true">
          <span class="pop-icon pop-icon--lime"><i class="ti ti-flame"></i></span>
          <span><strong>11:23 Daily Drop</strong><small>You’re tuned in</small></span>
        </div>
      </div>
    </div>
    <Skyline fill="var(--bg)" />
  </section>

  <section class="section">
    <div class="container two">
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-flame"></i></span>
        <h2 class="h3">Something new drops every day at 11:23</h2>
        <p>
          Every day at 11:23am, the Drop hits. One real reason to go, from a local spot near you, live for a limited time. It’s the nudge to put your phone down and actually get out.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-map-2"></i></span>
        <h2 class="h3">Explore keeps you coming back</h2>
        <p>
          Whenever you’re going out, open GOTYOU to see the best local spots near you, live on the map, morning to late night.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-wallet"></i></span>
        <h2 class="h3">Real cash, in your pocket</h2>
        <p>
          Check in, share, and rate the spots you visit. Every action earns, and your wallet shows the lifetime value you’ve unlocked.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-lock"></i></span>
        <h2 class="h3">Your info stays private</h2>
        <p>
          No email lists, no spam. Merchants only see your username — your email and phone number stay private.
        </p>
      </article>
    </div>
    <p class="where reveal">Live in 30+ zones across 12 states. <a href="/where-gotyou-works" class="link-arrow">See where GOTYOU works <i class="ti ti-arrow-right"></i></a></p>
  </section>
</BaseLayout>

<style>
  .dl {
    position: relative;
    overflow: hidden;
    padding-top: 56px;
  }
  .dl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 560px;
  }
  .display {
    margin: 10px 0 18px;
  }
  .lede {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 28px;
  }
  .next {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 30px;
    font-weight: 600;
  }
  .next :global(.countdown) {
    font-size: 30px;
    padding: 10px 18px;
    border-radius: 16px;
  }
  .art {
    position: relative;
    height: 600px;
    margin: 10px 0 30px;
  }
  .glow {
    position: absolute;
    inset: 12% 8%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(228, 255, 26, 0.32), rgba(255, 255, 255, 0.14) 55%, transparent);
    filter: blur(10px);
  }
  .fan {
    position: absolute;
    top: 50%;
    left: 50%;
  }
  .fan--center {
    z-index: 3;
    margin: -290px 0 0 -135px;
  }
  .fan--left {
    z-index: 1;
    margin: -230px 0 0 -255px;
    animation-delay: -2s;
  }
  .fan--right {
    z-index: 2;
    margin: -240px 0 0 35px;
    animation-delay: -4s;
  }
  .wallet {
    display: block;
    width: 226px;
    height: auto;
    transform: rotate(9deg);
    filter: drop-shadow(0 34px 40px rgba(15, 25, 60, 0.4));
  }
  .pop {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 18px 40px -12px rgba(10, 30, 90, 0.45);
    animation: pop-in 0.6s cubic-bezier(0.2, 0.9, 0.3, 1.3) both, float 7s ease-in-out 0.6s infinite;
  }
  .pop strong {
    display: block;
    font: 700 17px/1.2 var(--font-display);
  }
  .pop small {
    display: block;
    font-size: 13px;
    color: var(--muted);
  }
  .pop-icon {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    font: 800 17px var(--font-display);
    font-size: 22px;
  }
  .pop-icon--purple {
    background: linear-gradient(135deg, #b46cff, var(--purple));
    color: #fff;
  }
  .pop-icon--green {
    background: linear-gradient(135deg, #3cc98a, var(--green));
    color: #fff;
    font-size: 17px;
  }
  .pop-icon--lime {
    background: var(--lime);
    color: var(--lime-ink);
  }
  .pop--cash {
    /* sits over the wallet screenshot's own lifetime total */
    top: 22%;
    right: -2%;
    animation-delay: 0.2s, 0.8s;
  }
  .pop--earn {
    top: 44%;
    left: -4%;
    animation-delay: 0.45s, 1.6s;
  }
  .pop--drop {
    bottom: 8%;
    right: 2%;
    animation-delay: 0.7s, 2.4s;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pop {
      animation: none;
    }
  }
  .two {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .two h2 {
    margin: 18px 0 8px;
  }
  .two p {
    color: var(--muted);
  }
  .where {
    text-align: center;
    margin-top: 40px;
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .dl-grid,
    .two {
      grid-template-columns: 1fr;
    }
    .art {
      height: 520px;
      max-width: 460px;
      width: 100%;
      margin: 0 auto 20px;
      zoom: 0.86;
    }
    .next {
      flex-direction: column;
      align-items: flex-start;
    }
  }
  @media (max-width: 480px) {
    .art {
      zoom: 0.7;
    }
    .pop--earn {
      left: 0;
    }
    .pop--cash,
    .pop--drop {
      right: 0;
    }
  }
</style>
