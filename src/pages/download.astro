---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Phone from '../components/Phone.astro';
import DropCountdown from '../components/DropCountdown.astro';
---

<BaseLayout title="Download the app" description="Get paid for showing up. Download GOTYOU free — something new drops every day at 11:23.">
  <section class="dl sky">
    <div class="container dl-grid">
      <div class="copy">
        <span class="eyebrow eyebrow--pill"><span class="dot"></span>Free on iPhone & Android</span>
        <h1 class="display">Get paid for <span class="hl-lime">showing up.</span></h1>
        <p class="lede">Something new drops every day at 11:23. Download GOTYOU free and start today.</p>
        <StoreBadges size="lg" />
        <div class="next">
          <span>Next drop in</span>
          <DropCountdown />
        </div>
      </div>
      <div class="art" aria-hidden="true">
        <Phone src="/images/app/drop.jpg" alt="" width={260} tilt={-5} class="p1 float float--slow" eager />
        <Phone src="/images/app/explore-card.jpg" alt="" width={270} tilt={5} class="p2 float" eager />
      </div>
    </div>
    <Skyline fill="var(--bg)" />
  </section>

  <section class="section">
    <div class="container two">
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-flame"></i></span>
        <h2 class="h3">Something new drops every day at 11:23</h2>
        <p>
          Every day at 11:23am, the Drop hits. One real reason to go, from a local spot near you, live for a limited time. It’s the nudge to put your phone down and actually get out.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-map-2"></i></span>
        <h2 class="h3">Explore keeps you coming back</h2>
        <p>
          Whenever you’re going out, open GOTYOU to see the best local spots near you, live on the map, morning to late night.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-wallet"></i></span>
        <h2 class="h3">Real cash, in your pocket</h2>
        <p>
          Check in, share, and rate the spots you visit. Every action earns, and your wallet shows the lifetime value you’ve unlocked.
        </p>
      </article>
      <article class="card card--pad reveal">
        <span class="icon-circle"><i class="ti ti-lock"></i></span>
        <h2 class="h3">Your info stays private</h2>
        <p>
          No email lists, no spam. Merchants only see your username — your email and phone number stay private.
        </p>
      </article>
    </div>
    <p class="where reveal">Live in 30+ zones across 12 states. <a href="/where-gotyou-works" class="link-arrow">See where GOTYOU works <i class="ti ti-arrow-right"></i></a></p>
  </section>
</BaseLayout>

<style>
  .dl {
    position: relative;
    overflow: hidden;
    padding-top: 56px;
  }
  .dl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 560px;
  }
  .display {
    margin: 10px 0 18px;
  }
  .lede {
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 28px;
  }
  .next {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 30px;
    font-weight: 600;
  }
  .next :global(.countdown) {
    font-size: 30px;
    padding: 10px 18px;
    border-radius: 16px;
  }
  .art {
    position: relative;
    height: 580px;
  }
  .art :global(.p1) {
    position: absolute;
    left: 6%;
    top: 40px;
  }
  .art :global(.p2) {
    position: absolute;
    right: 6%;
    top: 0;
  }
  .two {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .two h2 {
    margin: 18px 0 8px;
  }
  .two p {
    color: var(--muted);
  }
  .where {
    text-align: center;
    margin-top: 40px;
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .dl-grid,
    .two {
      grid-template-columns: 1fr;
    }
    .art {
      height: 460px;
      max-width: 480px;
      width: 100%;
      margin: 0 auto;
    }
    .art :global(.phone) {
      --w: 200px !important;
    }
    .next {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
