---
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Phone from '../components/Phone.astro';
import DropCountdown from '../components/DropCountdown.astro';
import { BRAND } from '../lib/constants';

const steps = [
  { n: 'Step 1', icon: 'ti-hand-finger', title: 'Tap at 11:23', body: 'Every day, we drop One Great Deal from a local spot. No scrolling, no spam. Just today’s offer.', tag: 'Typical value: $5–$20' },
  { n: 'Step 2', icon: 'ti-checks', title: 'Claim or decline', body: 'Claim if you are going to use it. Decline if you are not. You still earn GET tokens for tapping and deciding.', tag: 'Up to $1.00 in GET every day' },
  { n: 'Step 3', icon: 'ti-building-store', title: 'Redeem and support a local business', body: 'Check in to redeem in-store. You save money, they get a real customer, and GOTYOU tracks the visit with no punch cards or emails.', tag: 'You save. They grow.' },
];
const next = ['Provo, UT', 'Knoxville, TN', 'Baton Rouge, LA', 'Lexington, KY', 'Athens, GA', 'Gainesville, FL'];
const sms = `sms:${BRAND.textToDownload.number.replace(/-/g, '')}?body=${BRAND.textToDownload.keyword}`;
---

<BaseLayout title="11:23 Daily Drops" description="One daily tap at 11:23. Real offers and money all year — a local deal worth around $5–$20, every day.">
  <section class="hero sky">
    <div class="container grid">
      <div>
        <span class="eyebrow eyebrow--pill"><i class="ti ti-flame"></i>GOTYOU · 11:23 Daily Drop</span>
        <h1 class="display">One daily tap at <span class="hl-lime">11:23.</span> Real offers & money all year.</h1>
        <p class="lede">
          Every day you get a local deal worth around $5–$20. Claim the deal if you are going to use it. Decline if you are not. You still earn GET tokens (up to $1.00 every day) just for tapping.
        </p>
        <div class="next-drop"><span>Next drop in</span><DropCountdown /></div>
        <div class="ctas">
          <a href={BRAND.dropDownloadUrl} class="btn btn--lime btn--lg"><i class="ti ti-download"></i>Download GOTYOU</a>
          <a href={sms} class="btn btn--ghost btn--lg"><i class="ti ti-message"></i>Text “{BRAND.textToDownload.keyword}” to {BRAND.textToDownload.number}</a>
        </div>
      </div>
      <div class="art">
        <img src="/images/site/daily-drop-neon.jpg" alt="11:23 Daily Drop neon sign" class="neon" />
        <Phone src="/images/app/drop.webp" alt="GOTYOU Drop screen counting down to 11:23" width={250} tilt={4} class="phone-pos float" eager />
      </div>
    </div>
    <Skyline fill="var(--bg)" />
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How 11:23 works</span>
        <h2 class="h2">Simple rule: tap once a day at 11:23 AM.</h2>
        <p class="lede">Claim if you will use it, decline if you will not. Either way you earn and local businesses win.</p>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <article class="card card--pad reveal">
            <span class="icon-circle"><i class:list={['ti', s.icon]}></i></span>
            <small>{s.n}</small>
            <h3 class="h3">{s.title}</h3>
            <p>{s.body}</p>
            <span class="chip">{s.tag}</span>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container markets reveal">
      <div>
        <span class="eyebrow">Next markets</span>
        <h2 class="h2">11:23 Daily Drops are coming to cities across the USA.</h2>
        <p class="lede">
          We’re expanding 11:23 Daily Drops from a single market to cities across the country, starting with our first 30 zones where we already have merchants and users.
        </p>
        <a href="/where-gotyou-works" class="link-arrow">See every zone <i class="ti ti-arrow-right"></i></a>
      </div>
      <ul class="cities">
        <li class="live"><i class="ti ti-flame"></i>St. George, UT<span>Live</span></li>
        {next.map((c) => <li><i class="ti ti-map-pin"></i>{c}<span>Next</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container final card reveal">
      <h2 class="h2">Get ready for the Drop in your city.</h2>
      <p class="lede">Download GOTYOU free — or text “{BRAND.textToDownload.keyword}” to {BRAND.textToDownload.number} and we’ll text you the link.</p>
      <StoreBadges size="lg" align="center" />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    overflow: hidden;
    padding-top: 64px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .display {
    font-size: clamp(36px, 5vw, 60px);
    margin: 10px 0 18px;
  }
  .lede {
    color: rgba(255, 255, 255, 0.9);
  }
  .next-drop {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 26px 0;
    font-weight: 600;
  }
  .next-drop :global(.countdown) {
    font-size: 30px;
    padding: 10px 18px;
    border-radius: 16px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .art {
    position: relative;
    min-height: 560px;
  }
  .neon {
    width: 90%;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px rgba(10, 30, 90, 0.35);
  }
  .art :global(.phone-pos) {
    position: absolute;
    right: 0;
    top: 70px;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .steps small {
    display: block;
    margin: 18px 0 4px;
    font-weight: 600;
    color: var(--blue);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 12.5px;
  }
  .steps h3 {
    margin-bottom: 8px;
  }
  .steps p {
    color: var(--muted);
    margin-bottom: 16px;
  }
  .section .lede {
    color: var(--muted);
  }
  .markets {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .markets .h2 {
    margin-bottom: 14px;
  }
  .markets .lede {
    margin-bottom: 18px;
  }
  .cities {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .cities li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    border-radius: 16px;
    background: var(--bg);
    font-weight: 600;
  }
  .cities li i {
    color: var(--blue);
  }
  .cities span {
    margin-left: auto;
    font-size: 12.5px;
    padding: 4px 10px;
    border-radius: 100px;
    background: var(--blue-50);
    color: var(--blue);
  }
  .cities .live {
    background: var(--ink);
    color: #fff;
  }
  .cities .live i {
    color: var(--lime);
  }
  .cities .live span {
    background: var(--lime);
    color: var(--ink);
  }
  .final {
    text-align: center;
    padding: 56px 24px;
    display: grid;
    gap: 16px;
    justify-items: center;
  }
  @media (max-width: 900px) {
    .grid,
    .markets,
    .steps {
      grid-template-columns: 1fr;
    }
    .art {
      min-height: 600px;
    }
    .art :global(.phone-pos) {
      --w: 250px !important;
      right: 50%;
      margin-right: -125px;
    }
    .neon {
      width: 100%;
    }
    .next-drop {
      flex-direction: column;
      align-items: flex-start;
    }
    .ctas .btn {
      white-space: normal;
    }
  }
</style>
