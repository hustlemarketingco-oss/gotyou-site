---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND, SOCIAL_LINKS } from '../lib/constants';

const socialIcons: Record<string, string> = {
  'Twitter/X': '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  Facebook: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M9.198 21.5h4v-8.01h3.604l.396-3.98h-4V7.5a1 1 0 011-1h3v-4h-3a5 5 0 00-5 5v2.01h-2l-.396 3.98h2.396z"/></svg>',
  Instagram: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="3.6"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor"/></svg>',
  TikTok: '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0115.54 3h-3.09v12.4a2.59 2.59 0 11-2.59-2.6c.18 0 .35.02.5.05V9.94c-.17-.02-.33-.04-.5-.04A5.5 5.5 0 005.36 15.4 5.5 5.5 0 0010.9 21a5.5 5.5 0 005.5-5.5V9.39a8.166 8.166 0 004.85 1.56V7.83a4.6 4.6 0 01-4.65-2.01z"/></svg>',
};
---

<BaseLayout title="Contact Us" description="We value your feedback and are eager to hear from you. Send us a message and we'll get back to you promptly.">
  <div class="page-hero">
    <div class="eyebrow" style="justify-content: center;">
      <span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
      Contact
    </div>
    <h1>Send us a message</h1>
    <p class="lede">Welcome to GOTYOU! We value your feedback and are eager to hear from you. Please send us an email, and we'll get back to you promptly.</p>
  </div>

  <div class="section" style="padding-top: 0;">
    <div class="contact-grid">
      <div class="contact-card">
        <h3>Get in touch</h3>
        <div class="contact-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><polyline points="3 7 12 13 21 7" /></svg>
          {BRAND.supportEmail}
        </div>
        <div class="contact-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 11a3 3 0 106 0 3 3 0 00-6 0z" /><path d="M12 21s-7-6.5-7-11a7 7 0 1114 0c0 4.5-7 11-7 11z" /></svg>
          Arizona Street, Santa Monica, CA 90401
        </div>
      </div>
      <div class="contact-card">
        <h3>Follow along</h3>
        <p>Stay up to date with new markets, merchant features, and the latest from the GOTYOU blog.</p>
        <div class="social-row">
          {
            SOCIAL_LINKS.map((s) => (
              <a href={s.href} class="social-icon" aria-label={s.label} target="_blank" rel="noopener" set:html={socialIcons[s.label]} />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
