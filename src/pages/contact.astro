---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { BRAND, SOCIAL_LINKS } from '../lib/constants';

const cards = [
  { icon: 'ti-mail', title: 'General & support', body: 'Questions about the app, your wallet, or anything else.', href: `mailto:${BRAND.supportEmail}`, label: BRAND.supportEmail },
  { icon: 'ti-building-store', title: 'Merchants & partnerships', body: 'Bring GOTYOU to your business or build a custom demand plan.', href: `mailto:${BRAND.helloEmail}?subject=GOTYOU%20for%20my%20business`, label: BRAND.helloEmail },
  { icon: 'ti-map-pin-plus', title: 'Bring GOTYOU to your city', body: 'Want GOTYOU in your community, or want to help promote it?', href: `mailto:${BRAND.helloEmail}?subject=Bring%20GOTYOU%20to%20my%20city`, label: 'Tell us where' },
];
---

<BaseLayout title="Contact" description="Get in touch with GOTYOU — we value your feedback and are eager to hear from you.">
  <PageHero eyebrow="Contact" title="We’d love to <em>hear from you.</em>" lede="We value your feedback and are eager to hear from you. Send us an email and we’ll get back to you promptly." />

  <section class="section">
    <div class="container">
      <div class="cards">
        {cards.map((c) => (
          <a href={c.href} class="card card--pad contact reveal">
            <span class="icon-circle"><i class:list={['ti', c.icon]}></i></span>
            <h2 class="h3">{c.title}</h2>
            <p>{c.body}</p>
            <span class="link-arrow">{c.label} <i class="ti ti-arrow-right"></i></span>
          </a>
        ))}
      </div>

      <div class="card card--pad more reveal">
        <div>
          <h2 class="h3">Follow along</h2>
          <p>New drops, local spots, and what’s next for GOTYOU.</p>
        </div>
        <div class="social">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener"><i class:list={['ti', s.icon]}></i>{s.label}</a>
          ))}
        </div>
        <p class="addr"><i class="ti ti-map-pin"></i>{BRAND.address}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .contact {
    display: flex;
    flex-direction: column;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .contact:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .contact h2 {
    margin: 18px 0 8px;
  }
  .contact p {
    color: var(--muted);
    margin-bottom: 18px;
    flex: 1;
  }
  .more {
    margin-top: 22px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px 32px;
    align-items: center;
  }
  .more p {
    color: var(--muted);
  }
  .social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .social a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 100px;
    background: var(--blue-50);
    color: var(--blue);
    font-weight: 600;
  }
  .social a:hover {
    background: var(--blue);
    color: #fff;
  }
  .addr {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .cards,
    .more {
      grid-template-columns: 1fr;
    }
  }
</style>
