---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { BRAND } from '../../lib/constants';

const jobs = (await getCollection('jobs')).sort((a, b) => b.data.posted.valueOf() - a.data.posted.valueOf());
const perks = [
  { icon: 'ti-rocket', title: 'Build something new', body: 'Help create a new category — Verified Physical Commerce — from the ground up.' },
  { icon: 'ti-map-pin', title: 'Work local, everywhere', body: 'Most roles are remote or in-market, close to the businesses and campuses we serve.' },
  { icon: 'ti-school', title: 'Learn from founders', body: 'Mentorship from a team that has spent 25 years helping small businesses win.' },
];
---

<BaseLayout title="Careers" description="Join GOTYOU and help Main Street compete with the giants. See open roles in sales, community growth, marketing, and content.">
  <PageHero eyebrow="Careers at GOTYOU" title="Help Main Street <em>win.</em>" lede="We’re a small team building the data layer physical commerce never had. If you love local businesses and want to move fast, we’d love to meet you." />

  <section class="section">
    <div class="container">
      <div class="perks">
        {perks.map((p) => (
          <div class="card card--pad reveal">
            <span class="icon-circle"><i class:list={['ti', p.icon]}></i></span>
            <h2 class="h3">{p.title}</h2>
            <p>{p.body}</p>
          </div>
        ))}
      </div>

      <div class="section-head section-head--left jobs-head">
        <span class="eyebrow">Open roles</span>
        <h2 class="h2">{jobs.length} ways to join the team</h2>
      </div>
      <ul class="jobs">
        {jobs.map((j) => (
          <li>
            <a href={`/careers/${j.id}`} class="job card reveal">
              <div>
                <h3>{j.data.title}</h3>
                <span class="meta"><i class="ti ti-map-pin"></i>{j.data.location}</span>
              </div>
              <span class="link-arrow">View role <i class="ti ti-arrow-right"></i></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="card card--pad general reveal">
        <div>
          <h2 class="h3">Don’t see your role?</h2>
          <p>Tell us how you’d help local businesses grow. We read every note.</p>
        </div>
        <a href={`mailto:${BRAND.helloEmail}?subject=Careers%20at%20GOTYOU`} class="btn btn--primary">Email {BRAND.helloEmail}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .perks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 72px;
  }
  .perks h2 {
    margin: 18px 0 8px;
  }
  .perks p {
    color: var(--muted);
  }
  .jobs-head {
    margin-bottom: 24px;
  }
  .jobs {
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .job {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 28px;
    transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  }
  .job:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
    border-color: var(--blue-100);
  }
  .job h3 {
    font-size: 19px;
    margin-bottom: 4px;
  }
  .meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: 14px;
  }
  .general {
    margin-top: 32px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }
  .general p {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .perks {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .job {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }
</style>
