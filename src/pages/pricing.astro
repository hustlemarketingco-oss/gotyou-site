---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pricing" description="Month to month, no long term contracts. Choose the GOTYOU plan that fits your business.">
  <div class="page-hero">
    <div class="eyebrow" style="justify-content: center;">
      <span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
      Transparent Pricing Plans
    </div>
    <h1>Choose the best plan for your business</h1>
    <p class="lede">Month to Month – No long term contracts.</p>
  </div>

  <div class="section" style="padding-top: 0;">
    <div class="section-inner">
      <div class="pricing-grid">
        <div class="price-card">
          <h3>Standard</h3>
          <div class="tag">Increase Customer Engagement</div>
          <div class="amt">$49<span>.95/mo</span></div>
          <ul>
            <li class="included">All Basic Features</li>
            <li class="included">Unlimited Customer Contacts</li>
            <li class="included">Customer Feedback Campaigns</li>
            <li class="included">Customer Referral Campaigns</li>
            <li>1 Custom Perk Campaign</li>
            <li>Remote Check-in Campaign</li>
            <li>$50 Setup Fee</li>
            <li>*Customer Reward Tokens $.20</li>
          </ul>
          <a href="https://app.gotyou.co/signup" class="btn-ghost" style="display:flex; justify-content:center; border-bottom:none; background: var(--card-light); border-radius: 100px;">Get Started</a>
        </div>
        <div class="price-card featured">
          <div class="badge">Most Popular</div>
          <h3>Plus</h3>
          <div class="tag">Increase Customer Frequency</div>
          <div class="amt">$99<span>.95/mo</span></div>
          <ul>
            <li class="included">All Standard Features</li>
            <li class="included">Survey Campaigns</li>
            <li class="included">1 Cross Promotion Campaign</li>
            <li>Personalized Perks/Incentives</li>
            <li>User Demographic Usage</li>
            <li>Dedicated Account Manager</li>
            <li>$100 Setup Fee</li>
            <li>*Customer Reward Tokens $.20</li>
          </ul>
          <a href="https://app.gotyou.co/signup" class="btn-primary" style="display:flex; justify-content:center;">Get Started</a>
        </div>
        <div class="price-card">
          <h3>Pro</h3>
          <div class="tag">Customer Growth and Local Brand Awareness</div>
          <div class="amt">$199<span>.95/mo</span></div>
          <ul>
            <li class="included">All Plus Features</li>
            <li class="included">3 Cross Promotions</li>
            <li class="included">Customized Branding</li>
            <li class="included">500 Printed Handouts</li>
            <li>Demographic Reporting</li>
            <li>1 IG/TT Post</li>
            <li>$150 Setup Fee</li>
            <li>*Customer Rewards Tokens $.20</li>
          </ul>
          <a href="https://app.gotyou.co/signup" class="btn-ghost" style="display:flex; justify-content:center; border-bottom:none; background: var(--card-light); border-radius: 100px;">Get Started</a>
        </div>
      </div>
      <p style="text-align:center; color: var(--text-dim); font-size: 13px; margin-top: 1.5rem;">***Less than 5 employees ask about our Trial $24.95 and other Startup pricing!</p>
    </div>
  </div>

  <div class="section">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-eyebrow">Feature List</span>
        <h2 class="section-title">The Power of GOTYOU</h2>
      </div>
      <div style="overflow-x: auto;">
        <table class="comparison-table">
          <thead>
            <tr><th>Feature</th><th>Basic<br /><span style="opacity:.6">$24.95</span></th><th>Standard<br /><span style="opacity:.6">$49.95</span></th><th>Plus<br /><span style="opacity:.6">$99.95</span></th><th>Pro<br /><span style="opacity:.6">$199.95</span></th></tr>
          </thead>
          <tbody>
            <tr><td>Setup Fee</td><td>$50</td><td>$50</td><td>$100</td><td>$150</td></tr>
            <tr><td>Customer Dashboard</td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>Customer Contacts</td><td>250</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td></tr>
            <tr><td>Feedback Campaigns</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>Referral Campaigns</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>Survey Campaigns</td><td>—</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>In-app Notifications</td><td>—</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>Customer Demographic Analytics</td><td>—</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td></tr>
            <tr><td>500 Promotional Handouts/mo</td><td>—</td><td>—</td><td>—</td><td class="yes">✓</td></tr>
            <tr><td>Reward Token Price</td><td>$0.20</td><td>$0.20</td><td>$0.20</td><td>$0.20</td></tr>
            <tr><td>Dedicated Account Manager</td><td>—</td><td>—</td><td class="yes">✓</td><td class="yes">✓</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="section" style="padding-top:0;">
    <div class="content-narrow" style="text-align:center;">
      <span class="section-eyebrow">Multi-Location Custom Pricing</span>
      <h2 style="text-align:center;">More than ten locations?</h2>
      <p>We feel that it is important to only pay for what you need to grow your brand. Connect with us and we will have a custom quote for you within 24 hours.</p>
      <a href="/contact" class="btn-primary">
        Contact us for Pricing
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" style="vertical-align:-2px"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
      </a>
    </div>
  </div>
</BaseLayout>
