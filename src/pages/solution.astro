---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { BRAND } from '../lib/constants';

const flow = [
  { icon: 'ti-speakerphone', title: 'Claim', body: 'A customer claims your offer wherever they saw it — a flyer, an Instagram post, an event handout, or your own daily drop.' },
  { icon: 'ti-nfc', title: 'Tap to redeem', body: 'They walk in, check in, and tap the GOTYOU pad on your counter to redeem. The visit is verified on the spot.' },
  { icon: 'ti-route', title: 'Attributed', body: 'GOTYOU ties that visit back to the source, so you finally see which channel put a real person in your store.' },
  { icon: 'ti-user-heart', title: 'Yours to keep', body: 'The customer — name, history, and behavior — is yours. You pay for real visits, not impressions.' },
];
---

<BaseLayout title="For local business" description="Own your customers. For good. GOTYOU is Verified Physical Commerce for local merchants — pay for real visits, not impressions.">
  <PageHero
    align="left"
    eyebrow="Local business solution"
    title="Own your customers. <em>For good.</em>"
    lede="Verified Physical Commerce for local merchants. Pay for real people standing in your store — not clicks, bots, or maybes."
  >
    <div class="hero-ctas">
      <a href="/pricing" class="btn btn--lime btn--lg">See pricing</a>
      <a href={BRAND.merchantSignupUrl} class="btn btn--ghost btn--lg">Get started</a>
    </div>
    <img slot="aside" src="/images/site/merchant_hero.jpg" alt="GOTYOU merchant dashboard on a laptop: see who walked in, win them back" class="hero-img" />
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">GOTYOU flips it</span>
        <h2 class="h2">You run offers everywhere. Now you can see which ones work.</h2>
        <p class="lede">
          When someone walks in today, you can’t tell what brought them — and the platforms that sent them keep the customer. Here’s how a GOTYOU visit works.
        </p>
      </div>
      <ol class="flow">
        {flow.map((f, i) => (
          <li class="card card--pad reveal">
            <span class="num">{i + 1}</span>
            <span class="icon-circle"><i class:list={['ti', f.icon]}></i></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white">
    <div class="container feature">
      <div class="reveal">
        <span class="eyebrow">Know every customer</span>
        <h2 class="h2">Not anonymous foot traffic. <span class="hl-blue">Real people, and they’re yours.</span></h2>
        <p class="lede">
          Every customer opts in. Every visit gets verified at the counter with a tap. For the first time, you know exactly who walks in, by name, how often they come back, and what brings them in.
        </p>
        <p class="lede">
          That’s your <strong>Behavior Graph</strong>: a living record of real-world visits that tells you who to reach, with what offer, and when. E-commerce has had this data for twenty years. Now you have it too — and it’s yours to keep.
        </p>
      </div>
      <img src="/images/site/dashboard_edited.png" alt="GOTYOU merchant dashboard showing check-ins and customers" loading="lazy" class="shot reveal" />
    </div>
  </section>

  <section class="section">
    <div class="container feature feature--flip">
      <div class="reveal">
        <span class="eyebrow">Real offers. Real visits. Verified.</span>
        <h2 class="h2">Never pay for a click, a bot, or a maybe.</h2>
        <p class="lede">
          Run offers your customers actually want, then watch them show up to redeem. Every redemption is verified at check-in with a tap, so you’re paying for a real person, standing in your store, doing business with you.
        </p>
        <ul class="ticks">
          <li><i class="ti ti-layout-dashboard"></i><span><b>The Counter</b> — launch an offer and track it in real time.</span></li>
          <li><i class="ti ti-bolt"></i><span><b>Power Hour</b> — fill your slow hours when you need to.</span></li>
          <li><i class="ti ti-flame"></i><span><b>11:23 Daily Drop</b> — your offer goes out to opted-in locals nearby at 11:23am.</span></li>
        </ul>
      </div>
      <div class="puck-wrap reveal">
        <img src="/images/site/puck_transparent.png" alt="GOTYOU Counter Tap NFC pad reading 'Tap here, earn here'" loading="lazy" class="float" />
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container price-band reveal">
      <div>
        <span class="eyebrow eyebrow--light"><span class="dot"></span>Pricing</span>
        <h2 class="h2">The platform is included. <span class="hl-lime">You only pay for customer demand.</span></h2>
        <p class="lede">Month-to-month, no setup fee, no contract — and a 100% delivery guarantee on every plan.</p>
      </div>
      <div class="mini-plans">
        <a href="/pricing" class="mini"><b>$1</b><span>Trial</span></a>
        <a href="/pricing" class="mini"><b>$175</b><span>50 customers / mo</span></a>
        <a href="/pricing" class="mini mini--hot"><b>$300</b><span>100 customers / mo</span></a>
        <a href="/pricing" class="mini"><b>$500</b><span>200 customers / mo</span></a>
      </div>
      <div class="band-ctas">
        <a href="/pricing" class="btn btn--lime btn--lg">Compare plans</a>
        <a href={`mailto:${BRAND.helloEmail}?subject=GOTYOU%20for%20my%20business`} class="btn btn--ghost btn--lg">Talk to us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-img {
    width: min(560px, 46%);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 70px rgba(10, 30, 90, 0.35);
  }
  .flow {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    counter-reset: f;
  }
  .flow li {
    position: relative;
  }
  .num {
    position: absolute;
    top: 22px;
    right: 24px;
    font-size: 44px;
    font-weight: 800;
    color: var(--blue-50);
    line-height: 1;
  }
  .flow h3 {
    font-size: 20px;
    margin: 18px 0 8px;
  }
  .flow p {
    color: var(--muted);
    font-size: 15px;
  }
  .feature {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .feature--flip {
    grid-template-columns: 1.1fr 0.9fr;
  }
  .feature .h2 {
    margin-bottom: 18px;
  }
  .feature .lede + .lede {
    margin-top: 14px;
  }
  .shot {
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    border: 1px solid var(--line);
  }
  .ticks {
    list-style: none;
    display: grid;
    gap: 14px;
    margin-top: 26px;
  }
  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .ticks i {
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--blue-50);
    color: var(--blue);
    font-size: 20px;
  }
  .puck-wrap {
    background: radial-gradient(circle at 50% 55%, #fff 0%, #e3effc 60%, transparent 61%);
    display: grid;
    place-items: center;
    padding: 30px;
  }
  .puck-wrap img {
    width: 92%;
    filter: drop-shadow(0 30px 30px rgba(20, 24, 51, 0.28));
  }
  .price-band {
    display: grid;
    gap: 36px;
    text-align: center;
    justify-items: center;
  }
  .price-band .h2 {
    max-width: 820px;
    margin: 0 auto 14px;
  }
  .mini-plans {
    display: grid;
    grid-template-columns: repeat(4, minmax(150px, 1fr));
    gap: 14px;
    width: 100%;
    max-width: 860px;
  }
  .mini {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    padding: 22px 12px;
    display: flex;
    flex-direction: column;
    transition: background 0.15s, transform 0.15s;
  }
  .mini:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: translateY(-3px);
  }
  .mini b {
    font-size: 34px;
    font-weight: 800;
  }
  .mini span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
  }
  .mini--hot {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--ink);
  }
  .mini--hot span {
    color: rgba(20, 24, 51, 0.7);
  }
  .band-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  @media (max-width: 1000px) {
    .flow {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 860px) {
    .hero-img {
      width: 100%;
      margin-bottom: 8px;
    }
    .feature,
    .feature--flip {
      grid-template-columns: 1fr;
    }
    .mini-plans {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .flow {
      grid-template-columns: 1fr;
    }
  }
</style>
