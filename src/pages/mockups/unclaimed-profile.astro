---
// Design mockup (noindex, excluded from the sitemap): unclaimed business profile.
import { getCollection } from 'astro:content';
import ProfileMock from '../../components/ProfileMock.astro';

const all = (await getCollection('businesses')).map((x) => x.data).filter((x) => !x.temporarilyClosed);
const b = all.find((x) => x.slug === 'five-sushi-brothers-provo')!;
---

<ProfileMock b={b} all={all} claimed={false} />
