---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { activeBusinesses, byCity, categoriesIn } from '../../lib/explore';
import { cityPath, categoryPath, plural } from '../../lib/profile-content';

const all = await activeBusinesses();
const cities = byCity(all);
const STATE_NAMES: Record<string, string> = { AL: 'Alabama', AK: 'Alaska', AZ: 'Arizona', AR: 'Arkansas', CA: 'California', CO: 'Colorado', CT: 'Connecticut', DE: 'Delaware', DC: 'Washington, DC', FL: 'Florida', GA: 'Georgia', HI: 'Hawaii', ID: 'Idaho', IL: 'Illinois', IN: 'Indiana', IA: 'Iowa', KS: 'Kansas', KY: 'Kentucky', LA: 'Louisiana', ME: 'Maine', MD: 'Maryland', MA: 'Massachusetts', MI: 'Michigan', MN: 'Minnesota', MS: 'Mississippi', MO: 'Missouri', MT: 'Montana', NE: 'Nebraska', NV: 'Nevada', NH: 'New Hampshire', NJ: 'New Jersey', NM: 'New Mexico', NY: 'New York', NC: 'North Carolina', ND: 'North Dakota', OH: 'Ohio', OK: 'Oklahoma', OR: 'Oregon', PA: 'Pennsylvania', RI: 'Rhode Island', SC: 'South Carolina', SD: 'South Dakota', TN: 'Tennessee', TX: 'Texas', UT: 'Utah', VT: 'Vermont', VA: 'Virginia', WA: 'Washington', WV: 'West Virginia', WI: 'Wisconsin', WY: 'Wyoming' };
// Cities grouped by state (largest first). Cities with a handful of listings get a compact link instead of a card.
const CARD_MIN = 15;
const states = [...new Set(cities.map((c) => c.state))]
  .map((st) => {
    const list = cities.filter((c) => c.state === st);
    return { st, name: STATE_NAMES[st] ?? st, total: list.reduce((n, c) => n + c.items.length, 0), big: list.filter((c) => c.items.length >= CARD_MIN), small: list.filter((c) => c.items.length < CARD_MIN) };
  })
  .sort((a, b) => b.total - a.total);
const site = Astro.site ?? Astro.url;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Directory', item: new URL('/businesses/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Explore by city', item: new URL('/explore/', site).href },
  ],
};
---

<BaseLayout title="Explore local spots by city" description={`Browse ${all.length} local businesses across ${cities.length} cities — the best restaurants, coffee shops, pizza, desserts and more, with hours, ratings and directions.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero eyebrow="Explore" title="Local spots, <em>city by city.</em>" lede={`${all.length.toLocaleString()} local businesses across ${cities.length} cities, with hours, ratings and directions.`} />

  <section class="section">
    <div class="container">
      <nav class="state-jump" aria-label="States">
        {states.map((s) => <a href={`#${s.st.toLowerCase()}`}>{s.name} <small>{s.total.toLocaleString()}</small></a>)}
      </nav>
      {states.map((s) => (
        <section class="state" id={s.st.toLowerCase()}>
          <h2 class="h3 state-title">{s.name} <small>{s.total.toLocaleString()} spots</small></h2>
          {s.big.length > 0 && (
            <div class="cities">
              {s.big.map((c) => (
                <article class="card card--pad city">
                  <h3><a href={cityPath(c.city, c.state)}>{c.city}, {c.state}</a></h3>
                  <p>{c.items.length} local {c.items.length === 1 ? 'spot' : 'spots'}</p>
                  <ul>
                    {categoriesIn(c.items).slice(0, 6).map((g) => (
                      <li>{g.hasPage ? <a href={categoryPath(c.city, c.state, g.category)}>{plural(g.category)}</a> : <span>{plural(g.category)}</span>} <small>{g.items.length}</small></li>
                    ))}
                  </ul>
                  <a href={cityPath(c.city, c.state)} class="link-arrow">Explore {c.city} <i class="ti ti-arrow-right"></i></a>
                </article>
              ))}
            </div>
          )}
          {s.small.length > 0 && (
            <div class="small-cities">
              {s.big.length > 0 && <h3>More in {s.name}</h3>}
              <ul>{s.small.map((c) => <li><a href={cityPath(c.city, c.state)}>{c.city}</a> <small>{c.items.length}</small></li>)}</ul>
            </div>
          )}
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .cities {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .state-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }
  .state-jump a {
    padding: 8px 14px;
    border-radius: 100px;
    background: var(--blue-50);
    color: var(--blue);
    font-weight: 600;
    font-size: 14.5px;
  }
  .state-jump small {
    color: var(--muted);
    font-weight: 500;
    margin-left: 4px;
  }
  .state {
    margin-bottom: 48px;
    scroll-margin-top: 90px;
  }
  .state-title {
    margin-bottom: 18px;
  }
  .state-title small {
    font-size: 15px;
    font-weight: 500;
    color: var(--muted);
    margin-left: 8px;
  }
  .small-cities {
    margin-top: 22px;
  }
  .small-cities h3 {
    font-size: 16px;
    margin-bottom: 10px;
  }
  .small-cities ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .small-cities a {
    color: var(--blue);
    font-weight: 500;
  }
  .small-cities small {
    color: var(--muted);
  }
  .city h3 {
    font-size: 22px;
  }
  .city h3 a:hover {
    color: var(--blue);
  }
  .city > p {
    color: var(--muted);
    margin-bottom: 14px;
  }
  .city ul {
    list-style: none;
    display: grid;
    gap: 6px;
    margin-bottom: 16px;
  }
  .city li {
    display: flex;
    justify-content: space-between;
  }
  .city li a {
    color: var(--blue);
    font-weight: 500;
  }
  .city small {
    color: var(--muted);
  }
</style>
