---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import SpotList from '../../../components/SpotList.astro';
import { activeBusinesses, byCity, categoriesIn, avgRating } from '../../../lib/explore';
import { categoryPath, cityPath, hoursFacts, plural, lc } from '../../../lib/profile-content';
import { categoryIcon } from '../../../lib/business';
import { topicsForCity, modifiersFor, topicPath } from '../../../lib/topics';

export async function getStaticPaths() {
  const all = await activeBusinesses();
  return byCity(all).map((c) => ({ params: { city: c.slug }, props: { group: c, others: byCity(all).filter((o) => o.slug !== c.slug) } }));
}

const { group, others } = Astro.props;
const { city, state, items } = group;
const cats = categoriesIn(items);
const topics = topicsForCity(items);
const searches = topics.flatMap((t) => [
  { href: topicPath(city, t.topic), label: t.topic.kind === 'feature' ? `${t.topic.label} in ${city}` : `Best ${lc(t.topic.label)} in ${city}` },
  ...modifiersFor(t.topic, t.items).map((m) => ({ href: topicPath(city, t.topic, m.mod.slug), label: m.mod.title(t.topic, city) })),
]);
const avg = avgRating(items);
const lateNight = items.filter((b) => (hoursFacts(b).latest ?? 0) >= 22 * 60).length;
const top = items.slice(0, 20);
const site = Astro.site ?? Astro.url;
const url = new URL(cityPath(city), site).href;

const intro = `GOTYOU lists ${items.length} local ${items.length === 1 ? 'business' : 'businesses'} in ${city}, ${state}${avg ? `, with an average Google rating of ${avg.toFixed(1)} stars` : ''}. The most popular right now are ${top.slice(0, 3).map((b) => b.name).join(', ')}${lateNight ? `, and ${lateNight} ${lateNight === 1 ? 'spot stays' : 'spots stay'} open until 10 PM or later` : ''}.`;
const faqs = [
  { q: `What are the best places to eat in ${city}, ${state}?`, a: `Based on Google ratings and review volume, top picks in ${city} include ${top.slice(0, 5).map((b) => `${b.name} (${b.googleRating?.toFixed(1) ?? '—'}★)`).join(', ')}.` },
  ...(lateNight ? [{ q: `What’s open late in ${city}?`, a: `${lateNight} ${lateNight === 1 ? 'spot is' : 'spots are'} open until 10 PM or later, including ${items.filter((b) => (hoursFacts(b).latest ?? 0) >= 22 * 60).slice(0, 3).map((b) => b.name).join(', ')}.` }] : []),
  { q: `How many restaurants and cafes in ${city} are on GOTYOU?`, a: `${items.length} — ${cats.map((c) => `${c.items.length} ${lc(plural(c.category))}`).join(', ')}.` },
];
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Directory', item: new URL('/businesses/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Explore', item: new URL('/explore/', site).href },
    { '@type': 'ListItem', position: 3, name: city, item: url },
  ] },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: `Top local spots in ${city}, ${state}`, itemListElement: top.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/businesses/${b.slug}/`, site).href, name: b.name })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={`Best local spots in ${city}, ${state}`} description={intro.slice(0, 300)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero eyebrow={`${city}, ${state}`} title={`The best local spots in <em>${city}</em>`} lede={intro}>
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/businesses/">Directory</a> › <a href="/explore/">Explore</a> › {city}</nav>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <div>
        <h2 class="h3 sec-title">Top {Math.min(20, items.length)} in {city}</h2>
        <SpotList items={top} />
        {items.length > top.length && <p class="more"><a href={`/businesses/?city=${encodeURIComponent(city)}`} class="link-arrow">See all {items.length} in {city} <i class="ti ti-arrow-right"></i></a></p>}

        {searches.length > 0 && (
          <section class="searches">
            <h2 class="h3 sec-title">Popular searches in {city}</h2>
            <div class="cloud">{searches.map((x) => <a href={x.href}>{x.label}</a>)}</div>
          </section>
        )}

        <section class="faq">
          <h2 class="h3 sec-title">Questions about {city}</h2>
          {faqs.map((f) => <details><summary>{f.q}<i class="ti ti-plus"></i></summary><p>{f.a}</p></details>)}
        </section>
      </div>
      <aside>
        <div class="card card--pad side">
          <h2>{city} by cuisine</h2>
          <ul>
            {topics.filter((t) => t.topic.kind === 'cuisine').map((t) => (
              <li><i class="ti ti-tools-kitchen-2"></i><a href={topicPath(city, t.topic)}>{t.topic.label}</a><small>{t.items.length}</small></li>
            ))}
          </ul>
        </div>
        <div class="card card--pad side">
          <h2>Popular in {city}</h2>
          <ul>
            {topics.filter((t) => t.topic.kind !== 'cuisine').map((t) => (
              <li><i class:list={['ti', t.topic.kind === 'category' ? categoryIcon(t.topic.label) : 'ti-star']}></i><a href={topicPath(city, t.topic)}>{t.topic.label}</a><small>{t.items.length}</small></li>
            ))}
          </ul>
        </div>
        {others.length > 0 && (
          <div class="card card--pad side">
            <h2>Nearby cities</h2>
            <ul>{others.map((o) => <li><i class="ti ti-map-pin"></i><a href={cityPath(o.city)}>{o.city}</a><small>{o.items.length}</small></li>)}</ul>
          </div>
        )}
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    margin-top: 18px;
    font-size: 14px;
    opacity: 0.9;
  }
  .crumbs a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 36px;
    align-items: start;
  }
  .sec-title {
    margin-bottom: 16px;
  }
  .more {
    margin-top: 18px;
  }
  .searches {
    margin-top: 48px;
  }
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cloud a {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 8px 14px;
    font-size: 14.5px;
    font-weight: 500;
    color: var(--blue);
  }
  .cloud a:hover {
    border-color: var(--blue);
  }
  .faq {
    margin-top: 48px;
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 2px 20px;
    margin-bottom: 10px;
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    font-weight: 600;
    padding: 14px 0;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary i {
    color: var(--blue);
  }
  .faq details p {
    color: var(--muted);
    padding-bottom: 14px;
  }
  .side {
    margin-bottom: 18px;
  }
  .side h2 {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .side ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .side li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .side li i {
    color: var(--blue);
  }
  .side li a {
    color: var(--blue);
    font-weight: 500;
  }
  .side small {
    margin-left: auto;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
