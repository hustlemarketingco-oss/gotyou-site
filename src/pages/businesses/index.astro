---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DirectorySearch from '../../components/DirectorySearch.astro';
import { sizedPhoto } from '../../lib/business';
import Skyline from '../../components/Skyline.astro';
import { byCity, categoriesIn } from '../../lib/explore';
import { cityPath, categoryPath, plural } from '../../lib/profile-content';

const allBusinesses = (await getCollection('businesses')).filter((b) => !b.data.temporarilyClosed);

// Serialize just what the client-side search island needs — keeps the
// hydrated payload small instead of shipping full Astro content entries.
const searchIndex = allBusinesses.map((b) => ({
  slug: b.data.slug,
  name: b.data.name,
  category: b.data.category,
  googleCategory: b.data.googleCategory ?? b.data.category,
  city: b.data.city,
  address: b.data.address,
  claimStatus: b.data.claimStatus,
  rating: b.data.googleRating ?? 0,
  reviews: b.data.googleReviewCount ?? 0,
  price: b.data.priceRange ?? '',
  photo: sizedPhoto(b.data.photoUrl, 640, 420) ?? '',
}));

const cities = [...new Set(allBusinesses.map((b) => b.data.city))].sort();
const cityGroups = byCity(allBusinesses.map((b) => b.data));
---

<BaseLayout
  title="Local Business Directory"
  description={`Find local spots near you across ${cities.length} cities. Browse ${allBusinesses.length} local businesses, see hours and ratings, and earn cash for showing up with GOTYOU.`}
>
  <section class="dir-hero">
    <div class="dir-hero-inner">
      <span class="eyebrow eyebrow--pill"><span class="dot"></span>Your city. One drop a day.</span>
      <h1>Find the local spots <span class="hl">worth showing up for</span></h1>
      <p class="lede">
        Hours, ratings and directions for the businesses near you — and the ones on GOTYOU pay you real cash for the visit.
      </p>
      <form class="search" id="dirSearchForm" role="search" onsubmit="return false">
        <i class="ti ti-search" aria-hidden="true"></i>
        <input type="search" id="searchInput" placeholder="Tacos, coffee, a place name…" aria-label="Search businesses" />
        <select id="cityFilter" aria-label="City">
          <option value="">All cities</option>
          {cities.map((c) => <option value={c}>{c}</option>)}
        </select>
      </form>
      <div class="hero-stats">
        <span><strong>{allBusinesses.length.toLocaleString()}</strong> local businesses</span>
        <span class="sep" aria-hidden="true"></span>
        <span><strong>{cities.length}</strong> cities</span>
        <span class="sep" aria-hidden="true"></span>
        <a href="#claim-cta">Own a business? <u>Claim it free</u></a>
      </div>
    </div>
    <Skyline fill="var(--bg)" />
  </section>

  <div class="theme-light">
    <DirectorySearch businesses={searchIndex} />
  </div>

  <section class="browse">
    <div class="browse-inner">
      <h2>Browse by city</h2>
      <div class="browse-grid">
        {cityGroups.map((c) => (
          <div>
            <a href={cityPath(c.city)} class="city-link">{c.city} <small>{c.items.length}</small></a>
            <ul>
              {categoriesIn(c.items).filter((g) => g.hasPage).map((g) => (
                <li><a href={categoryPath(c.city, g.category)}>{plural(g.category)}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="claim-band" id="claim-cta">
    <div class="claim-band-inner reveal">
      <div>
        <span class="section-eyebrow">For business owners</span>
        <h2>Customers are already looking you up. Turn the look into a visit.</h2>
        <p>Claim your free listing to fix your details, see who's checking in, and reward the regulars who keep coming back.</p>
      </div>
      <div class="claim-band-actions">
        <a href="https://app.gotyou.co" class="btn-primary">Merchant login <i class="ti ti-arrow-right"></i></a>
        <a href="/solution" class="btn-outline-dark">How it works</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .dir-hero {
    position: relative;
    overflow: hidden;
    padding: 72px 0 0;
    text-align: center;
    color: #fff;
    background: var(--grad-sky);
  }
  .dir-hero-inner {
    padding: 0 1.5rem;
  }
  .dir-hero-inner {
    max-width: 780px;
    margin: 0 auto;
  }
  .dir-hero h1 {
    font-size: clamp(34px, 5.2vw, 58px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.03em;
    margin: 6px 0 18px;
    text-shadow: 0 2px 24px rgba(10, 40, 110, 0.18);
  }
  .hl {
    color: var(--yellow);
  }
  .lede {
    color: rgba(255, 255, 255, 0.9);
    font-size: 17px;
    max-width: 600px;
    margin: 0 auto 32px;
  }
  .search {
    display: flex;
    align-items: center;
    background: #fff;
    border-radius: 100px;
    padding: 6px 6px 6px 22px;
    box-shadow: 0 18px 50px rgba(10, 40, 110, 0.3);
    max-width: 640px;
    margin: 0 auto;
  }
  .search > i {
    color: #8b91ab;
    font-size: 20px;
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    font: 16px var(--font-body);
    padding: 12px 12px;
    color: #0b1029;
    background: transparent;
  }
  .search select {
    border: none;
    outline: none;
    background: #eef1f7;
    color: #0b1029;
    font: 600 14px var(--font-body);
    padding: 12px 16px;
    border-radius: 100px;
    cursor: pointer;
    max-width: 44%;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 10px 16px;
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 14px;
  }
  .hero-stats strong {
    color: #fff;
  }
  .hero-stats a:hover {
    color: var(--yellow);
  }
  .sep {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.6);
  }

  .browse {
    background: var(--bg);
    padding: 8px 1.5rem 48px;
  }
  .browse-inner {
    max-width: 1200px;
    margin: 0 auto;
  }
  .browse h2 {
    font-size: 24px;
    margin-bottom: 18px;
  }
  .browse-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 20px;
  }
  .city-link {
    font-weight: 700;
    color: var(--ink);
  }
  .city-link small {
    color: var(--muted);
    font-weight: 500;
  }
  .browse ul {
    list-style: none;
    margin-top: 6px;
    display: grid;
    gap: 4px;
  }
  .browse li a {
    color: var(--blue);
    font-size: 14.5px;
  }
  .claim-band {
    background: var(--bg);
    padding: 24px 1.5rem 96px;
  }
  .claim-band-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: center;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius-lg);
    padding: 3rem;
  }
  .claim-band .section-eyebrow {
    color: var(--yellow);
  }
  .claim-band h2 {
    font-size: clamp(24px, 3vw, 34px);
    line-height: 1.15;
    margin-bottom: 12px;
  }
  .claim-band p {
    color: rgba(255, 255, 255, 0.78);
  }
  .claim-band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
  }
  @media (max-width: 800px) {
    .claim-band-inner {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
    }
    .claim-band-actions {
      justify-content: flex-start;
    }
  }
  @media (max-width: 520px) {
    .dir-hero {
      padding: 48px 0 0;
    }
    .dir-hero-inner {
      padding: 0 16px;
    }
    .search {
      flex-wrap: wrap;
      border-radius: 20px;
      padding: 8px 8px 8px 16px;
    }
    .search input {
      flex-basis: 70%;
    }
    .search select {
      flex-basis: 100%;
      max-width: none;
      margin-top: 4px;
    }
  }
</style>
