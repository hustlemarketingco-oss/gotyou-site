---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import ClaimSidebar from '../../components/ClaimSidebar.astro';

// This is the function that turns "businesses in the content collection"
// into "real pages on the site." Every entry in src/content/businesses/
// becomes a page here automatically — add a new JSON file (via the seed
// script or by hand) and the next build produces a new URL with zero
// additional code.
export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map((b) => ({
    params: { slug: b.data.slug },
    props: { business: b.data, allBusinesses: businesses },
  }));
}

const { business, allBusinesses } = Astro.props;

const nearby = allBusinesses
  .filter((b) => b.data.slug !== business.slug && b.data.city === business.city)
  .slice(0, 4);

const estimatedTokensEarnedNearby = Math.round(business.checkinCount * 2.4);

const pageTitle = business.metaTitle || `${business.name} — ${business.city}`;
const pageDescription =
  business.metaDescription ||
  business.description ||
  `${business.name} is a ${business.category.toLowerCase()} in ${business.city}. Check in to earn $GET tokens on GOTYOU.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div class="section-inner profile-wrap">
    <a href="/businesses" class="back-link"><i class="ti ti-arrow-left" /> Back to directory</a>

    <div class="profile-hero">
      <div class="hero-inner">
        <div class="icon"><i class="ti ti-building-store" /></div>
        <div class="info">
          <span class="cat-tag">{business.category}</span>
          <h1>{business.name}</h1>
          <div class="meta-row">
            <div class="meta-item"><i class="ti ti-map-pin" />{business.address}, {business.city}</div>
            {business.phone && <div class="meta-item"><i class="ti ti-phone" />{business.phone}</div>}
          </div>
          <div class="status-row">
            <StatusBadge status={business.claimStatus} />
          </div>
        </div>
      </div>
    </div>

    <div class="profile-layout">
      <div class="profile-main">
        {business.description && (
          <section class="card">
            <h2>About this business</h2>
            <p>{business.description}</p>
          </section>
        )}

        <section class="card">
          <h2>GOTYOU activity</h2>
          <div class="stats-row">
            <div class="stat-box"><div class="n">{business.checkinCount}</div><div class="l">Total check-ins</div></div>
            <div class="stat-box"><div class="n">{estimatedTokensEarnedNearby}</div><div class="l">$GET tokens earned nearby</div></div>
          </div>
          {business.claimStatus === 'unclaimed' ? (
            <p class="callout callout--unclaimed">
              <strong>This business is unclaimed.</strong> Customers are already checking in here. Claim your listing to see full analytics, manage your profile, and create token offers.
            </p>
          ) : (
            <p class="callout callout--claimed">
              <strong>This business is active on GOTYOU.</strong> Download the app to earn $GET tokens on your next visit.
            </p>
          )}
        </section>

        {nearby.length > 0 && (
          <section class="card">
            <h2>Nearby businesses on GOTYOU</h2>
            <div class="nearby-grid">
              {nearby.map((n) => (
                <a href={`/businesses/${n.data.slug}`} class="nearby-card">
                  <div class="nearby-icon"><i class="ti ti-building-store" /></div>
                  <div class="nearby-info">
                    <div class="name">{n.data.name}</div>
                    <div class:list={['status', n.data.claimStatus]}>
                      {n.data.claimStatus === 'claimed' ? '✓ On GOTYOU' : 'Unclaimed'}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="profile-sidebar">
        <ClaimSidebar slug={business.slug} name={business.name} claimStatus={business.claimStatus} />
      </aside>
    </div>
  </div>

  <style>
    .profile-wrap {
      padding: 2rem 1.5rem 4rem;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 1.5rem;
      padding: 8px 0;
    }
    .back-link:hover {
      color: var(--text);
    }

    .profile-hero {
      background: var(--blue);
      border-radius: var(--radius);
      padding: 2.5rem;
      margin-bottom: 1.5rem;
    }
    .hero-inner {
      display: flex;
      gap: 1.5rem;
      align-items: flex-start;
    }
    .icon {
      width: 72px;
      height: 72px;
      border-radius: 14px;
      background: rgba(255, 255, 255, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      font-size: 32px;
      color: #fff;
    }
    .cat-tag {
      display: inline-block;
      background: rgba(255, 255, 255, 0.15);
      color: rgba(255, 255, 255, 0.85);
      padding: 3px 10px;
      border-radius: 20px;
      font-size: 12px;
      margin-bottom: 12px;
    }
    .info h1 {
      font-size: clamp(20px, 4vw, 28px);
      font-weight: 800;
      color: #fff;
      margin-bottom: 4px;
    }
    .meta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 8px;
    }
    .meta-item {
      display: flex;
      align-items: center;
      gap: 6px;
      color: rgba(255, 255, 255, 0.7);
      font-size: 13px;
    }
    .status-row {
      margin-top: 1rem;
    }

    .profile-layout {
      display: grid;
      grid-template-columns: 1fr 320px;
      gap: 1.5rem;
      align-items: start;
    }
    @media (max-width: 700px) {
      .profile-layout {
        grid-template-columns: 1fr;
      }
    }

    .card {
      background: var(--white);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 1.5rem;
      margin-bottom: 1.25rem;
    }
    .card h2 {
      font-size: 16px;
      font-weight: 700;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
      color: var(--text);
    }
    .card p {
      font-size: 15px;
      line-height: 1.7;
      color: var(--muted);
    }

    .stats-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-bottom: 1.25rem;
    }
    .stat-box {
      background: var(--bg);
      border-radius: 10px;
      padding: 1rem;
      text-align: center;
    }
    .stat-box .n {
      font-family: var(--font-display);
      font-size: 22px;
      font-weight: 700;
      color: var(--text);
    }
    .stat-box .l {
      font-size: 11px;
      color: var(--muted);
      margin-top: 2px;
    }

    .callout {
      font-size: 13px;
      border-radius: 8px;
      padding: 12px;
    }
    .callout--unclaimed {
      background: #fff6f3;
      border-left: 3px solid #ff6b2b;
      color: var(--muted);
    }
    .callout--claimed {
      background: #f0fdf9;
      border-left: 3px solid var(--green);
      color: var(--muted);
    }

    .nearby-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .nearby-card {
      background: var(--bg);
      border-radius: 10px;
      padding: 12px;
      display: flex;
      gap: 10px;
      align-items: center;
      transition: background 0.2s;
    }
    .nearby-card:hover {
      background: #eeeee8;
    }
    .nearby-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.06);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      color: var(--blue);
      flex-shrink: 0;
    }
    .nearby-info .name {
      font-size: 13px;
      font-weight: 600;
      line-height: 1.3;
      color: var(--text);
    }
    .nearby-info .status {
      font-size: 11px;
      margin-top: 2px;
    }
    .nearby-info .status.claimed {
      color: var(--green);
    }
    .nearby-info .status.unclaimed,
    .nearby-info .status.pending {
      color: #c2530f;
    }
  </style>
</BaseLayout>
