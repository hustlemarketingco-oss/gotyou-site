---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ClaimSidebar from '../../components/ClaimSidebar.astro';
import { DAYS, categoryIcon, formatPhone, sizedPhoto, to24hRanges, websiteHost } from '../../lib/business';
import { profileContent, cityPath, categoryPath, plural, fmtMiles, MIN_CATEGORY_LISTINGS } from '../../lib/profile-content';
import { cuisinesFor } from '../../lib/topics';

// This is the function that turns "businesses in the content collection"
// into "real pages on the site." Every entry in src/content/businesses/
// becomes a page here automatically — add a new JSON file (via the seed
// script or by hand) and the next build produces a new URL with zero
// additional code.
export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  return businesses.map((b) => ({
    params: { slug: b.data.slug },
    props: { business: b.data, allBusinesses: businesses },
  }));
}

const { business: b, allBusinesses } = Astro.props;

// Nearby: same city, same category first, then best-rated.
const nearby = allBusinesses
  .map((x) => x.data)
  .filter((x) => x.slug !== b.slug && x.city === b.city && !x.temporarilyClosed)
  .sort(
    (x, y) =>
      Number(y.category === b.category) - Number(x.category === b.category) ||
      (y.googleRating ?? 0) * Math.log10((y.googleReviewCount ?? 0) + 10) -
        (x.googleRating ?? 0) * Math.log10((x.googleReviewCount ?? 0) + 10),
  )
  .slice(0, 4);

const phone = formatPhone(b.phone);
const host = websiteHost(b.website);
const fullAddress = [b.address, b.city, [b.state, b.zip].filter(Boolean).join(' ')].filter(Boolean).join(', ');
const directionsUrl =
  b.lat && b.lng
    ? `https://www.google.com/maps/dir/?api=1&destination=${b.lat},${b.lng}${b.placeId ? `&destination_place_id=${b.placeId}` : ''}`
    : `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${b.name} ${fullAddress}`)}`;
// Merchant-supplied photos (after claiming) win; the Google photo is only a temporary fallback.
const heroPhoto = b.ownerPhotoUrl ?? sizedPhoto(b.photoUrl, 1600, 900);
const allData = allBusinesses.map((x) => x.data).filter((x) => !x.temporarilyClosed);
const content = profileContent(b, allData);
const hasCategoryPage = allData.filter((x) => x.city === b.city && x.category === b.category).length >= MIN_CATEGORY_LISTINGS;
const site = Astro.site ?? Astro.url;
const pageUrl = new URL(`/businesses/${b.slug}/`, site).href;
const updated = b.updatedAt ? new Date(b.updatedAt) : undefined;
const updatedLabel = updated?.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Stable, short Google Maps URL from the place's CID (the long /maps/place/... link changes over time).
const mapsUrl = b.googleCid ? `https://maps.google.com/?cid=${b.googleCid}` : b.googleMapsUrl?.split('?')[0];
const servesCuisine = cuisinesFor(b);
const icon = categoryIcon(b.category);
const kind = (b.googleCategory ?? b.category).toLowerCase();

const pageTitle = b.metaTitle || `${b.name} — ${b.googleCategory ?? b.category} in ${b.city}, ${b.state}`;
const pageDescription = b.metaDescription || content.summary;

const hasHours = b.hours && Object.values(b.hours).some(Boolean);

// Keyless Google Maps embed (the OpenStreetMap embed needs WebGL, which some devices lack).
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${b.name}, ${fullAddress}`)}&z=16&output=embed`;

// schema.org structured data. Google ratings are deliberately NOT emitted as aggregateRating:
// Google's review-snippet rules only allow ratings collected on this site.
const schemaType =
  b.category === 'Coffee & Cafe'
    ? 'CafeOrCoffeeShop'
    : b.category === 'Desserts & Bakery'
      ? /ice cream|frozen yogurt/i.test(kind) ? 'IceCreamShop' : 'Bakery'
      : b.category === 'Bars & Pubs'
        ? 'BarOrPub'
        : ['Restaurant', 'Fast Food', 'Pizza', 'Mexican & Latin', 'Asian & Pacific'].includes(b.category)
          ? b.category === 'Fast Food' ? 'FastFoodRestaurant' : 'Restaurant'
          : 'LocalBusiness';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: b.name,
  '@id': `${pageUrl}#business`,
  url: pageUrl,
  ...(b.ownerPhotoUrl && { image: b.ownerPhotoUrl }),
  ...(b.phone && { telephone: b.phone }),
  ...(b.priceRange && { priceRange: b.priceRange }),
  // Entity links: the business's own site and its Google Maps listing identify it unambiguously.
  ...((b.website || mapsUrl) && { sameAs: [b.website, mapsUrl].filter(Boolean) }),
  ...(mapsUrl && { hasMap: mapsUrl }),
  description: b.description || content.summary,
  ...(servesCuisine.length && { servesCuisine }),
  ...(b.amenities.length && {
    amenityFeature: b.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a, value: true })),
  }),
  address: {
    '@type': 'PostalAddress',
    streetAddress: b.address,
    addressLocality: b.city,
    addressRegion: b.state,
    ...(b.zip && { postalCode: b.zip }),
    addressCountry: 'US',
  },
  ...(b.lat && b.lng && { geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng } }),
  ...(hasHours && {
    openingHoursSpecification: DAYS.flatMap(([key, dayName]) => {
      const v = b.hours?.[key];
      if (!v || v === 'Closed') return [];
      return to24hRanges(v).map((r) => {
        const [opens, closes] = r.split('-');
        return { '@type': 'OpeningHoursSpecification', dayOfWeek: dayName, opens, closes };
      });
    }),
  }),
};
const breadcrumbs = [
  { name: 'Directory', url: new URL('/businesses/', site).href },
  { name: b.city, url: new URL(cityPath(b.city), site).href },
  ...(hasCategoryPage ? [{ name: `${plural(b.category)} in ${b.city}`, url: new URL(categoryPath(b.city, b.category), site).href }] : []),
  { name: b.name, url: pageUrl },
];
const pageLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': pageUrl,
    url: pageUrl,
    name: pageTitle,
    description: content.summary,
    about: { '@id': `${pageUrl}#business` },
    ...(updated && { dateModified: updated.toISOString() }),
    isPartOf: { '@type': 'WebSite', name: 'GOTYOU', url: new URL('/', site).href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<BaseLayout title={pageTitle} description={pageDescription.slice(0, 300)} ogImage={b.ownerPhotoUrl ?? `/og/businesses/${b.slug}.jpg`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(pageLd)} />
  <link slot="head" rel="alternate" type="application/json" href={`/businesses/${b.slug}.json`} title={`${b.name} — structured data`} />

  <section class="p-hero">
    {heroPhoto && <img class="p-hero-img" src={heroPhoto} alt="" referrerpolicy="no-referrer" fetchpriority="high" />}
    <div class="p-hero-shade"></div>
    <div class="p-hero-inner">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/businesses/">Directory</a><i class="ti ti-chevron-right"></i>
        <a href={cityPath(b.city)}>{b.city}</a>
        {hasCategoryPage && <><i class="ti ti-chevron-right"></i><a href={categoryPath(b.city, b.category)}>{plural(b.category)}</a></>}
      </nav>
      <span class="cat-chip"><i class:list={['ti', icon]}></i>{b.googleCategory ?? b.category}</span>
      <h1>{b.name}</h1>
      <div class="facts">
        {b.googleRating && (
          <span class="fact"><i class="ti ti-star-filled star"></i><strong>{b.googleRating.toFixed(1)}</strong> ({b.googleReviewCount?.toLocaleString()} Google reviews)</span>
        )}
        {b.priceRange && <span class="fact">{b.priceRange}</span>}
        <span class="fact"><i class="ti ti-map-pin"></i>{b.city}, {b.state}</span>
        {b.temporarilyClosed ? (
          <span class="open-pill closed">Temporarily closed</span>
        ) : (
          hasHours && <span class="open-pill" id="openNow" hidden></span>
        )}
        {b.claimStatus === 'claimed' && <span class="open-pill on"><i class="ti ti-circle-check-filled"></i> On GOTYOU</span>}
      </div>
    </div>
  </section>

  <div class="theme-light">
    <div class="actions-wrap">
      <div class="actions">
        {phone && <a class="act act--primary" href={`tel:${b.phone}`}><i class="ti ti-phone"></i><span>Call<small>{phone}</small></span></a>}
        <a class="act" href={directionsUrl} target="_blank" rel="noopener"><i class="ti ti-directions"></i><span>Directions<small>{b.address}</small></span></a>
        {b.website && <a class="act" href={b.website} target="_blank" rel="noopener nofollow"><i class="ti ti-world"></i><span>Website<small>{host}</small></span></a>}
        {b.googleMapsUrl && <a class="act" href={b.googleMapsUrl} target="_blank" rel="noopener"><i class="ti ti-brand-google-maps"></i><span>Google Maps<small>Photos & reviews</small></span></a>}
      </div>
    </div>

    <div class="p-layout">
      <div class="p-main">
        <section class="block reveal">
          <h2>About {b.name}</h2>
          <p class="summary">{content.summary}</p>
          <dl class="quick">
            {content.quick.map((q) => <div><dt>{q.label}</dt><dd>{q.value}</dd></div>)}
          </dl>
          {content.paras.map((p) => <p class="about">{p}</p>)}
          {b.secondaryCategories.length > 0 && (
            <div class="tags">{b.secondaryCategories.map((c) => <span class="tag">{c}</span>)}</div>
          )}
        </section>

        {hasHours && (
          <section class="block reveal" id="hoursBlock" data-tz={b.timezone ?? ''} data-hours={JSON.stringify(b.hours)}>
            <h2>Hours</h2>
            <table class="hours">
              <tbody>
                {DAYS.map(([key, label]) => (
                  <tr data-day={key}>
                    <th scope="row">{label}</th>
                    <td class:list={[b.hours?.[key] === 'Closed' && 'is-closed']}>
                      {b.hours?.[key] && b.hours[key] !== 'Closed' && !/24 hours/i.test(b.hours[key]!)
                        ? to24hRanges(b.hours[key]!).map((r, i) => {
                            const [o, c] = r.split('-');
                            const parts = b.hours![key]!.split(',')[i]?.split(' - ') ?? [];
                            return <>{i > 0 && ', '}<time datetime={o}>{parts[0]?.trim()}</time> – <time datetime={c}>{parts[1]?.trim()}</time></>;
                          })
                        : b.hours?.[key] ?? '—'}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="fine">Hours from Google{updatedLabel && `, last checked ${updatedLabel}`}; holidays may differ.</p>
          </section>
        )}

        {b.amenities.length > 0 && (
          <section class="block reveal">
            <h2>Good to know</h2>
            <ul class="amenities">
              {b.amenities.map((a) => <li><i class="ti ti-check"></i>{a}</li>)}
            </ul>
          </section>
        )}

        <section class="block reveal">
          <h2>Location</h2>
          <div class="map">
            <iframe src={mapSrc} title={`Map of ${b.name}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
          <div class="loc-row">
            <address><i class="ti ti-map-pin"></i>{fullAddress}</address>
            <a href={directionsUrl} target="_blank" rel="noopener" class="link">Get directions <i class="ti ti-arrow-up-right"></i></a>
          </div>
          {content.nearby.sameCategory.length > 0 && (
            <div class="near-list">
              <h3>Nearby {plural(b.category).toLowerCase()}</h3>
              <ul>
                {content.nearby.sameCategory.map((x) => (
                  <li><a href={`/businesses/${x.biz.slug}/`}>{x.biz.name}</a><span>{x.biz.googleCategory ?? x.biz.category} · {fmtMiles(x.mi)}</span></li>
                ))}
              </ul>
            </div>
          )}
        </section>

        <section class="block reveal" id="faq">
          <h2>Questions about {b.name}</h2>
          {content.faqs.map((f) => (
            <details>
              <summary>{f.q}<i class="ti ti-plus"></i></summary>
              <p>{f.a}</p>
            </details>
          ))}
          {updatedLabel && <p class="fine">Listing details last updated {updatedLabel}. Own this business? <a href={`/businesses/${b.slug}/claim/`}>Claim it</a> to keep it accurate.</p>}
        </section>
      </div>

      <aside class="p-side">
        <div class="sticky">
          <ClaimSidebar slug={b.slug} name={b.name} claimStatus={b.claimStatus} />
        </div>
      </aside>
    </div>

    {nearby.length > 0 && (
      <section class="nearby">
        <div class="nearby-inner">
          <div class="nearby-head">
            <h2>More in {b.city}</h2>
            <a href={hasCategoryPage ? categoryPath(b.city, b.category) : cityPath(b.city)} class="link">{hasCategoryPage ? `All ${plural(b.category).toLowerCase()} in ${b.city}` : `See all in ${b.city}`} <i class="ti ti-arrow-right"></i></a>
          </div>
          <div class="nearby-grid">
            {nearby.map((n) => (
              <a href={`/businesses/${n.slug}`} class="n-card reveal">
                <div class="n-photo">
                  <i class:list={['ti', categoryIcon(n.category)]}></i>
                  {n.photoUrl && <img src={sizedPhoto(n.photoUrl, 480, 320)} alt="" loading="lazy" referrerpolicy="no-referrer" />}
                </div>
                <div class="n-body">
                  <strong>{n.name}</strong>
                  <span>
                    {n.googleRating ? <><i class="ti ti-star-filled star"></i> {n.googleRating.toFixed(1)} · </> : null}
                    {n.googleCategory ?? n.category}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  {(phone || directionsUrl) && (
    <div class="mobile-bar">
      {phone && <a href={`tel:${b.phone}`} class="mb mb--primary"><i class="ti ti-phone"></i> Call</a>}
      <a href={directionsUrl} target="_blank" rel="noopener" class="mb"><i class="ti ti-directions"></i> Directions</a>
    </div>
  )}

  <script>
    // Highlight today's row and show "Open now / Closed now" in the business's own timezone.
    const block = document.getElementById('hoursBlock');
    if (block) {
      const tz = block.dataset.tz || undefined;
      const hours: Record<string, string> = JSON.parse(block.dataset.hours || '{}');
      const parts = Object.fromEntries(
        new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', hourCycle: 'h23' })
          .formatToParts(new Date())
          .map((p) => [p.type, p.value]),
      );
      const keys = ['sun', 'mon', 'tue', 'wed', 'thu', 'fri', 'sat'];
      const today = parts.weekday.toLowerCase().slice(0, 3);
      const yesterday = keys[(keys.indexOf(today) + 6) % 7];
      const now = Number(parts.hour) * 60 + Number(parts.minute);
      block.querySelector(`tr[data-day="${today}"]`)?.classList.add('today');

      const mins = (s: string) => {
        const m = s.trim().match(/^(\d{1,2}):(\d{2}) (AM|PM)$/);
        return m ? ((Number(m[1]) % 12) + (m[3] === 'PM' ? 12 : 0)) * 60 + Number(m[2]) : null;
      };
      const ranges = (v?: string) =>
        !v || v === 'Closed'
          ? []
          : /open 24 hours/i.test(v)
            ? [[0, 1440]]
            : v.split(',').map((r) => r.split(' - ').map(mins)).filter((r) => r.length === 2 && r[0] !== null && r[1] !== null) as number[][];

      let open = false;
      let closesAt: number | null = null;
      for (const [o, c] of ranges(hours[today])) {
        const end = c <= o ? c + 1440 : c; // past midnight
        if (now >= o && now < end) (open = true), (closesAt = end % 1440);
      }
      for (const [o, c] of ranges(hours[yesterday])) {
        if (c <= o && now < c) (open = true), (closesAt = c); // still open from last night
      }
      const pill = document.getElementById('openNow');
      if (pill && hours[today] !== undefined) {
        const fmt = (m: number) => {
          const h = Math.floor(m / 60) % 24;
          return `${h % 12 || 12}${m % 60 ? `:${String(m % 60).padStart(2, '0')}` : ''} ${h < 12 ? 'AM' : 'PM'}`;
        };
        pill.textContent = open ? (closesAt === 0 && /24 hours/i.test(hours[today]) ? 'Open 24 hours' : `Open now · until ${fmt(closesAt ?? 0)}`) : 'Closed now';
        pill.classList.add(open ? 'open' : 'closed');
        pill.hidden = false;
      }
    }
  </script>
</BaseLayout>

<style>
  /* ── hero ── */
  .p-hero {
    position: relative;
    color: #fff;
    min-height: 440px;
    display: flex;
    align-items: flex-end;
    background: var(--grad-sky);
    overflow: hidden;
  }
  .p-hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .p-hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(11, 16, 41, 0.25) 0%, rgba(11, 16, 41, 0.55) 45%, rgba(11, 16, 41, 0.95) 100%);
  }
  .p-hero-inner {
    position: relative;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 1.5rem 40px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 18px;
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .crumbs i {
    font-size: 13px;
    opacity: 0.6;
  }
  .cat-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 6px 12px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
  }
  .cat-chip i {
    color: var(--yellow);
  }
  .p-hero h1 {
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.45);
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin: 14px 0 16px;
    max-width: 900px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 22px;
    font-size: 15px;
    color: rgba(255, 255, 255, 0.85);
  }
  .fact {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fact strong {
    color: #fff;
  }
  .star {
    color: #f5a623;
  }
  .open-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
  }
  .open-pill.open {
    background: rgba(34, 197, 94, 0.18);
    color: #6ee7a0;
    border: 1px solid rgba(34, 197, 94, 0.4);
  }
  .open-pill.closed {
    background: rgba(255, 107, 43, 0.16);
    color: #ffb08a;
    border: 1px solid rgba(255, 107, 43, 0.4);
  }
  .open-pill.on {
    background: var(--yellow);
    color: var(--navy);
  }

  /* ── action bar ── */
  .actions-wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    transform: translateY(-28px);
    box-shadow: 0 18px 40px rgba(11, 16, 41, 0.12);
  }
  .act {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    background: var(--white);
    color: var(--text);
    font-weight: 600;
    transition: background 0.15s;
  }
  .act:hover {
    background: #f7f9fd;
  }
  .act i {
    font-size: 22px;
    color: var(--blue);
    flex: none;
  }
  .act span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .act small {
    font-weight: 400;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .act--primary {
    background: var(--yellow);
  }
  .act--primary:hover {
    background: #d4f000;
  }
  .act--primary i {
    color: var(--navy);
  }
  .act--primary small {
    color: rgba(11, 16, 41, 0.7);
  }

  /* ── body ── */
  .p-layout {
    max-width: 1200px;
    margin: 0 auto;
    padding: 8px 1.5rem 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 28px;
    align-items: start;
  }
  .block {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 26px 28px;
    margin-bottom: 20px;
  }
  .block h2 {
    font-size: 20px;
    margin-bottom: 14px;
    color: var(--text);
  }
  .summary {
    font-size: 18px;
    font-weight: 500;
    line-height: 1.6;
    color: var(--ink);
    margin-bottom: 16px;
  }
  .quick {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 10px;
    margin-bottom: 18px;
  }
  .quick div {
    background: var(--bg);
    border-radius: 14px;
    padding: 10px 14px;
  }
  .quick dt {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
  }
  .quick dd {
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
  }
  .about {
    font-size: 16.5px;
    line-height: 1.7;
    color: #2b3247;
  }
  .about + .about {
    margin-top: 12px;
  }
  .near-list {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
