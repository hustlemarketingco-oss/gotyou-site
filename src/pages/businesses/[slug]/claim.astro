---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const businesses = await getCollection('businesses');
  // Only generate claim pages for businesses that can still be claimed —
  // no point shipping a claim form for an already-claimed listing.
  return businesses
    .filter((b) => b.data.claimStatus !== 'claimed')
    .map((b) => ({
      params: { slug: b.data.slug },
      props: { business: b.data },
    }));
}

const { business } = Astro.props;
---

<BaseLayout title={`Claim ${business.name}`} description={`Verify ownership of ${business.name} to manage your GOTYOU listing.`}>
  <div class="section">
    <div class="container narrow">
      <a href={`/businesses/${business.slug}`} class="back-link"><i class="ti ti-arrow-left" /> Back to {business.name}</a>

      <div class="form-card">
        <h1>Claim {business.name}</h1>
        <p>Verify ownership to manage your GOTYOU listing, access analytics, and create token offers for your customers.</p>

        <!--
          Phase 1: this form posts to /api/claim, which emails the GotYou team
          for manual verification. Phase 2: swap the action to write directly
          to the app DB once the backend connection is in place — the form
          markup itself doesn't need to change.
        -->
        <form method="POST" action="/api/claim">
          <input type="hidden" name="businessSlug" value={business.slug} />
          <input type="hidden" name="businessName" value={business.name} />

          <div class="field">
            <label for="name">Your name</label>
            <input type="text" id="name" name="name" placeholder="Jane Smith" required />
          </div>
          <div class="field">
            <label for="email">Business email</label>
            <input type="email" id="email" name="email" placeholder="you@yourbusiness.com" required />
          </div>
          <div class="field">
            <label for="phone">Phone number</label>
            <input type="tel" id="phone" name="phone" placeholder="(801) 555-0100" required />
          </div>
          <div class="field">
            <label for="role">Your role at this business</label>
            <input type="text" id="role" name="role" placeholder="Owner, Manager, etc." />
          </div>

          <button type="submit" class="btn btn--primary btn--lg submit-btn">Submit Claim Request &rarr;</button>
          <p class="fine-print">We'll verify and activate your listing within 24 hours.</p>
        </form>
      </div>
    </div>
  </div>

  <style>
    .narrow {
      max-width: 540px;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 1.5rem;
    }
    .back-link:hover {
      color: var(--text);
    }

    .form-card {
      background: var(--white);
      border-radius: var(--radius-lg);
      border: 1px solid var(--border);
      box-shadow: var(--shadow);
      padding: 2.5rem;
    }
    .form-card h1 {
      font-size: 28px;
      font-weight: 800;
      margin-bottom: 0.5rem;
      color: var(--text);
    }
    .form-card > p {
      font-size: 14px;
      color: var(--muted);
      margin-bottom: 1.5rem;
      line-height: 1.6;
    }

    .field {
      margin-bottom: 1rem;
    }
    .field label {
      display: block;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 6px;
      color: var(--text);
    }
    .field input {
      width: 100%;
      padding: 13px 16px;
      border: 1px solid var(--border);
      border-radius: 14px;
      font-size: 15px;
      font-family: var(--font-body);
      outline: none;
      transition: border-color 0.2s;
    }
    .field input:focus {
      border-color: var(--blue);
    }

    .submit-btn {
      width: 100%;
      justify-content: center;
      margin-top: 0.5rem;
    }
    .fine-print {
      font-size: 12px;
      color: var(--muted);
      text-align: center;
      margin-top: 12px;
    }
  </style>
</BaseLayout>
