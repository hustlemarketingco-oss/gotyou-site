---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout title="GOTYOU" description="Discover, connect, and unlock exclusive rewards at local businesses. Earn cash, perks, and elevate your status — all in one free app.">
  <div class="hero">
    <div class="hero-inner">
      <div>
        <div class="hero-label">How GOTYOU works</div>
        <h1>Download the free app</h1>
        <p class="hero-bold">Local Savings and Connection, Simplified</p>
        <p class="hero-sub">
          At GOTYOU, our free app connects you with local merchants effortlessly—no email lists, no spam.
          <br /><br />
          Discover and support your favorite businesses while earning real cash rewards for dining, shopping, and exploring. GOTYOU makes it easy, secure, and rewarding—your personal info stays private, and your everyday actions pay off.
        </p>
        <a href="/download" class="btn btn--yellow">GET STARTED &rsaquo;</a>
      </div>
      <div class="hero-img">
        <img src="/images/app-marketplace.png" alt="GOTYOU app marketplace screen" class="phone-back" />
        <img src="/images/app-checkin.png" alt="GOTYOU app check-in screen" class="phone-front" />
      </div>
    </div>
  </div>

  <div class="section section--white">
    <div class="section-inner">
      <div class="center">
        <span class="section-label">How GOTYOU Works</span>
        <h2 class="section-title">Three ways to earn</h2>
        <p class="section-sub">No email lists, no spam — just real rewards for the things you're already doing.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="step-num">1</span>
          <div class="step-icon"><i class="ti ti-map-check" /></div>
          <h3>Check In & Earn Instantly</h3>
          <p>Every time you visit, refresh the GOTYOU app, select the merchant, and hit Check-In—you'll instantly earn a cash reward for supporting your favorite local spots!</p>
        </div>
        <div class="step">
          <span class="step-num">2</span>
          <div class="step-icon"><i class="ti ti-star" /></div>
          <h3>Earn Status, Perks & Rewards</h3>
          <p>Leave feedback, answer a quick survey, or refer a friend. Every action earns you $GET points—our universal rewards currency you can cash out or use at any GOTYOU business.</p>
        </div>
        <div class="step">
          <span class="step-num">3</span>
          <div class="step-icon"><i class="ti ti-building-store" /></div>
          <h3>Save Big on Everyday Purchases</h3>
          <p>Dine out, shop, or catch a movie—and save at thousands of local businesses. GOTYOU turns your everyday spending into real rewards, all in one app.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="section section--white">
    <div class="section-inner">
      <div class="center">
        <span class="section-label">Built For Every Business</span>
        <h2 class="section-title">From salons to street tacos</h2>
        <p class="section-sub">Wherever you check in, GOTYOU is there — see what it looks like in the wild.</p>
      </div>
      <div class="checkin-grid">
        <div class="checkin-card">
          <img src="/images/check-in-salon.png" alt="Customer checking in with the GOTYOU app at a salon" />
          <span class="checkin-label">Salons &amp; Spas</span>
        </div>
        <div class="checkin-card">
          <img src="/images/checkin-retail-shop.png" alt="Customer checking in with the GOTYOU app at a retail boutique" />
          <span class="checkin-label">Retail &amp; Boutiques</span>
        </div>
        <div class="checkin-card">
          <img src="/images/check-in-mexican.png" alt="Customer checking in with the GOTYOU app at a restaurant counter" />
          <span class="checkin-label">Restaurants</span>
        </div>
        <div class="checkin-card">
          <img src="/images/checkin-coffee-shop.png" alt="Customer redeeming GOTYOU rewards at a coffee shop" />
          <span class="checkin-label">Coffee Shops</span>
        </div>
      </div>
    </div>
  </div>

  <div class="section section--cream">
    <div class="section-inner">
      <div class="two-col">
        <div>
          <span class="section-label">$GET Points</span>
          <h2>Earn Status, Perks, and Rewards with Every Visit</h2>
          <p>After checking in, take it further—leave feedback, answer a quick survey, or refer a friend. Every action earns you $GET points, our universal rewards currency, which you can cash out or use to support more local businesses in the GOTYOU network.</p>
          <p>Explore the many ways you can make real money with GOTYOU while helping your community thrive!</p>
        </div>
        <div class="img-box">
          <img src="/images/get-points.png" alt="GOTYOU $GET points wallet" />
        </div>
      </div>
    </div>
  </div>

  <div class="section section--white">
    <div class="section-inner">
      <div class="center">
        <span class="section-label">The GOTYOU Blog</span>
        <h2 class="section-title">Latest From Our Blog</h2>
      </div>
      <div class="blog-grid">
        {
          posts.map((post) => (
            <a href={`/blog/${post.id}`} class="blog-card">
              <div class="blog-img">
                {post.data.heroImage ? <img src={post.data.heroImage} alt={post.data.title} /> : <i class="ti ti-article" />}
                <span class="blog-tag">{post.data.tag}</span>
              </div>
              <div class="blog-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="blog-meta"><i class="ti ti-calendar" />{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</div>
              </div>
            </a>
          ))
        }
      </div>
      <div class="center" style="margin-top: 2rem;">
        <a href="/blog" class="btn btn--blue">View All Posts</a>
      </div>
    </div>
  </div>

  <div class="cta">
    <h2>Join Us Along This Journey!</h2>
    <p>Download the free GOTYOU app and start earning real cash rewards at local businesses today.</p>
    <div class="cta-btns">
      <a href="/download" class="app-btn"><i class="ti ti-brand-apple" /><div><span class="s">Download on the</span><span class="b">App Store</span></div></a>
      <a href="/download" class="app-btn"><i class="ti ti-brand-google-play" /><div><span class="s">Get it on</span><span class="b">Google Play</span></div></a>
    </div>
  </div>

  <style>
    .hero { background: var(--bg); padding: 64px 2.5rem 56px; }
    .hero-inner { max-width: 1080px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
    @media (max-width: 800px) { .hero-inner { grid-template-columns: 1fr; } }
    .hero-label { font-family: var(--font-display); font-size: 13px; font-weight: 700; color: var(--yellow-2); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; }
    .hero h1 { font-size: clamp(28px, 4vw, 48px); font-weight: 900; color: var(--text); line-height: 1.1; margin-bottom: 1.25rem; }
    .hero-bold { font-weight: 700; font-size: 16px; color: var(--text); margin-bottom: .5rem; }
    .hero-sub { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 2rem; }
    .hero-img { position: relative; display: flex; align-items: flex-end; justify-content: center; }
    .hero-img img { border-radius: 20px; max-height: 480px; width: auto; object-fit: contain; }
    .phone-back { position: absolute; right: 0; bottom: 0; width: 55%; opacity: .9; }
    .phone-front { position: relative; z-index: 2; width: 58%; }

    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-top: 3rem; }
    .step { background: #fff; border-radius: var(--radius); border: 1px solid var(--border); padding: 2rem; position: relative; overflow: hidden; }
    .step-num { position: absolute; top: 8px; right: 14px; font-family: var(--font-display); font-size: 64px; font-weight: 900; color: rgba(21,101,216,.07); line-height: 1; }
    .step-icon { width: 50px; height: 50px; border-radius: 50%; background: var(--blue); display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; }
    .step-icon i { font-size: 24px; color: #fff; }
    .step h3 { font-size: 17px; font-weight: 700; margin-bottom: .5rem; }
    .step p { font-size: 14px; color: var(--muted); line-height: 1.65; }

    .checkin-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-top: 2.5rem; }
    @media (max-width: 900px) { .checkin-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 480px) { .checkin-grid { grid-template-columns: 1fr; } }
    .checkin-card { position: relative; border-radius: var(--radius); overflow: hidden; aspect-ratio: 3 / 4; }
    .checkin-card img { width: 100%; height: 100%; object-fit: cover; }
    .checkin-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 16px 14px 12px; background: linear-gradient(to top, rgba(0,0,0,.75), transparent); color: #fff; font-family: var(--font-display); font-size: 13px; font-weight: 700; }

    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
    @media (max-width: 720px) { .two-col { grid-template-columns: 1fr; } }
    .two-col h2 { font-size: clamp(20px, 2.8vw, 28px); font-weight: 800; margin-bottom: 1rem; color: var(--text); line-height: 1.25; }
    .two-col p { font-size: 15px; color: var(--muted); line-height: 1.75; margin-bottom: 1rem; }
    .img-box img { width: 100%; border-radius: var(--radius); }

    .blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 1.5rem; margin-top: 2.5rem; }
    .blog-card { background: #fff; border-radius: var(--radius); border: 1px solid var(--border); overflow: hidden; display: block; transition: transform .2s, box-shadow .2s; }
    .blog-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(0,0,0,.1); }
    .blog-img { height: 170px; background: var(--blue); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; }
    .blog-img img { width: 100%; height: 100%; object-fit: cover; }
    .blog-img > i { font-size: 44px; color: rgba(255,255,255,.2); }
    .blog-tag { position: absolute; bottom: 10px; left: 10px; background: var(--yellow); color: #000; padding: 3px 10px; border-radius: 4px; font-size: 10px; font-weight: 700; font-family: var(--font-display); text-transform: uppercase; letter-spacing: .3px; }
    .blog-body { padding: 1.25rem; }
    .blog-body h3 { font-size: 15px; font-weight: 700; line-height: 1.4; margin-bottom: 8px; color: var(--text); }
    .blog-body p { font-size: 13px; color: var(--muted); line-height: 1.6; margin-bottom: 12px; }
    .blog-meta { font-size: 12px; color: var(--muted); display: flex; align-items: center; gap: 6px; }

    .cta { background: var(--blue); padding: 72px 2.5rem; text-align: center; }
    .cta h2 { font-size: clamp(24px, 4vw, 38px); font-weight: 900; color: #fff; margin-bottom: 1rem; }
    .cta p { color: rgba(255,255,255,.7); font-size: 16px; max-width: 520px; margin: 0 auto 2.5rem; line-height: 1.7; }
    .cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .app-btn { display: flex; align-items: center; gap: 12px; background: rgba(255,255,255,.1); border: 2px solid rgba(255,255,255,.3); color: #fff; padding: 12px 24px; border-radius: 10px; font-family: var(--font-display); transition: all .2s; }
    .app-btn:hover { background: #fff; color: var(--blue); }
    .app-btn i { font-size: 24px; }
    .app-btn .s { font-size: 10px; opacity: .7; display: block; text-transform: uppercase; letter-spacing: .5px; }
    .app-btn .b { font-size: 15px; font-weight: 700; display: block; }
  </style>
</BaseLayout>
