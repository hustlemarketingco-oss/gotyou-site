---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Skyline from '../components/Skyline.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Phone from '../components/Phone.astro';
import DropCountdown from '../components/DropCountdown.astro';
import CtaBand from '../components/CtaBand.astro';
import { sizedPhoto, categoryIcon } from '../lib/business';
import { BRAND } from '../lib/constants';

const businesses = (await getCollection('businesses')).map((b) => b.data).filter((b) => b.photoUrl && !b.temporarilyClosed);
const score = (b: (typeof businesses)[number]) => (b.googleRating ?? 0) * Math.log10((b.googleReviewCount ?? 0) + 10);
const featured = businesses.sort((a, b) => score(b) - score(a)).slice(0, 8);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const steps = [
  {
    n: '01',
    title: 'Find your spot',
    body: 'Open Explore to see the best local spots near you, live on the map from morning to late night. Slide from near to hot to see what everyone’s into right now.',
    img: '/images/app/explore-map.webp',
    alt: 'GOTYOU Explore map showing local spots around Tempe and Scottsdale',
    phone: true,
  },
  {
    n: '02',
    title: 'Check in and earn instantly',
    body: 'Tap the merchant and check in. GOTYOU verifies you’re actually there and drops cash into your account on the spot. Real visits, real spots, real rewards.',
    img: '/images/app/checkin.webp',
    alt: 'GOTYOU local status card: earn for checking in, sharing and rating',
    phone: true,
  },
  {
    n: '03',
    title: 'Watch it add up',
    body: 'Leave feedback, share, rate, or refer a friend. Every action earns more. Your wallet tracks every cent, and your status grows at the places you love.',
    img: '/images/site/mockup-wallet-750.webp',
    alt: 'GOTYOU wallet showing $46.65 lifetime value unlocked and three offers ready to redeem',
  },
];
---

<BaseLayout title="GOTYOU" description={`${BRAND.promise} GOTYOU points you to the right local spot, then pays you real cash for showing up.`}>
  <!-- ───────── Hero ───────── -->
  <section class="hero sky">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow eyebrow--pill"><span class="dot"></span>Your city. One drop a day.</span>
        <h1 class="display">The daily <span class="hl-lime">match</span> between locals and the businesses near them.</h1>
        <p class="lede">
          GOTYOU reads the moment and points you to the right local spot — then pays you real cash for showing up.
        </p>
        <StoreBadges size="lg" />
        <a href="/businesses" class="explore-link">Or explore local spots on the web <i class="ti ti-arrow-right"></i></a>
      </div>
      <div class="hero-art">
        <img src="/images/site/mockup-map-offers.webp" srcset="/images/site/mockup-map-offers-640.webp 640w, /images/site/mockup-map-offers.webp 1200w" sizes="(max-width: 900px) 100vw, 600px" alt="The GOTYOU app: a live map of local spots and today's offers from Chipotle Mexican Grill" class="hero-mockup" fetchpriority="high" width="1200" height="1094" />
        <div class="bubble bubble--earn float" aria-hidden="true">
          <span class="plus">+5<span class="gy"></span></span>
          <span><b>Pier 49 Pizza</b><small>Review · $0.05 value</small></span>
        </div>
        <div class="bubble bubble--wallet float float--slow" aria-hidden="true">
          <i class="ti ti-wallet"></i>
          <span><b>$46.65</b><small>Lifetime value unlocked</small></span>
        </div>
        <div class="bubble bubble--drop float float--slow" aria-hidden="true">
          <i class="ti ti-flame"></i>
          <span><b>11:23 Daily Drop</b><small>You’re tuned in</small></span>
        </div>
      </div>
    </div>
    <Skyline fill="var(--bg)" />
  </section>

  <!-- ───────── Proof strip ───────── -->
  <section class="proof">
    <div class="container proof-row">
      <div><strong>30+</strong><span>live zones</span></div>
      <div><strong>12</strong><span>states</span></div>
      <div><strong>2,000+</strong><span>local businesses</span></div>
      <div><strong>11:23</strong><span>a new drop, every day</span></div>
      <div><strong>$0</strong><span>to join, always</span></div>
    </div>
  </section>

  <!-- ───────── How it works ───────── -->
  <section class="section" id="how-it-works">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How GOTYOU works</span>
        <h2 class="h2">Local rewards, <span class="hl-blue">minus the noise.</span></h2>
        <p class="lede">
          The free GOTYOU app connects you directly to the local spots you love — no email lists, no spam, no coupon apps to juggle. Your info stays private. Your everyday habits finally pay you back.
        </p>
      </div>
      <div class="steps">
        {steps.map((s) => (
          <article class="step card reveal">
            <div class="step-shot">
              {s.phone ? <Phone src={s.img} alt={s.alt} width={250} /> : <img src={s.img} alt={s.alt} loading="lazy" class="mockup" />}
            </div>
            <div class="step-copy">
              <span class="step-n">{s.n}</span>
              <h3 class="h3">{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── Daily Drop ───────── -->
  <section class="drop sky">
    <div class="container drop-grid">
      <div class="drop-copy reveal">
        <span class="eyebrow eyebrow--pill"><i class="ti ti-flame"></i>11:23 Daily Drop</span>
        <h2 class="h2">The <span class="hl-lime">hottest</span> deals are dropping in</h2>
        <DropCountdown />
        <p class="lede">
          Every day at 11:23am, the Drop hits. One real reason to go, from a local spot near you, live for a limited time. It’s the nudge to put your phone down and actually get out.
        </p>
        <a href="/download" class="btn btn--lime btn--lg"><i class="ti ti-bell"></i>Tune in to the Drop</a>
      </div>
      <div class="drop-art reveal">
        <img src="/images/site/daily-drop-neon.jpg" alt="11:23 Daily Drop neon sign" loading="lazy" class="neon" />
        <Phone src="/images/app/drop.webp" alt="GOTYOU Drop screen counting down to the 11:23 Daily Drop" width={250} tilt={3} class="drop-phone" />
      </div>
    </div>
    <Skyline fill="var(--surface)" />
  </section>

  <!-- ───────── Show some love (status) ───────── -->
  <section class="section section--white">
    <div class="container love-grid">
      <div class="status-card reveal" aria-label="Example GOTYOU local status card">
        <div class="status-ring"><img src="/images/site/mascot-explorer.jpg" alt="GOTYOU Explorer mascot" loading="lazy" /></div>
        <span class="lvl">Level 1 · Explorer</span>
        <p class="lvl-title">The adventure begins!</p>
        <p class="love">Show some love</p>
        <div class="actions">
          <div><span class="ic"><i class="ti ti-circle-check-filled"></i></span>Check in<b>5<span class="gy"></span></b></div>
          <div><span class="ic"><i class="ti ti-share"></i></span>Share<b>5<span class="gy"></span></b></div>
          <div><span class="ic"><i class="ti ti-star"></i></span>Rate<b>1<span class="gy"></span></b></div>
        </div>
      </div>
      <div class="love-copy reveal">
        <span class="eyebrow">Status & perks</span>
        <h2 class="h2">Earn status, perks, and rewards with every visit.</h2>
        <p class="lede">
          Go beyond the check-in. Leave feedback, answer a quick survey, or refer a friend — every action earns more rewards you can cash out or spend across the GOTYOU network.
        </p>
        <p class="lede">The more you show up, the more your status and perks grow at the places you love.</p>
        <ul class="ticks">
          <li><i class="ti ti-map-pin-check"></i>Visits verified on the spot — no receipts, no punch cards</li>
          <li><i class="ti ti-lock"></i>Merchants only see your username. Your email and phone stay private</li>
          <li><i class="ti ti-arrows-exchange"></i>Works alongside the loyalty apps you already use</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── Wallet ───────── -->
  <section class="section wallet">
    <div class="container wallet-grid">
      <div class="wallet-copy reveal">
        <span class="eyebrow">One app. Real cash.</span>
        <h2 class="h2">Spent right back into <span class="grad-text">your community.</span></h2>
        <p class="lede">
          Dine out, shop, catch a movie — earn at local businesses across the GOTYOU network. Stop juggling apps, emails, texts, and coupons. GOTYOU turns your everyday visits into real cash, and keeps that value in the neighborhood where you spent it.
        </p>
        <a href="/download" class="btn btn--primary btn--lg">Start earning free</a>
      </div>
      <div class="wallet-cards reveal" aria-label="Example GOTYOU wallet">
        <div class="wcard wcard--earn">
          <span class="wl"><i class="ti ti-coins"></i>Earning</span>
          <strong>2,140<span class="gy"></span></strong>
          <span>value <b>$21.40</b></span>
          <small>Since joining</small>
        </div>
        <div class="wcard wcard--save">
          <span class="wl"><i class="ti ti-moneybag"></i>Saving</span>
          <strong>$25.25</strong>
          <span>USD</span>
          <small>Since joining</small>
        </div>
        <ul class="activity">
          <li><span class="av">P</span><span><b>Pier 49 Pizza</b><small>Review</small></span><em>+5<span class="gy"></span></em></li>
          <li><span class="av av--2">C</span><span><b>Chipotle Mexican Grill</b><small>Check in</small></span><em>+5<span class="gy"></span></em></li>
          <li><span class="av av--3">H</span><span><b>Hash Kitchen</b><small>Share</small></span><em>+5<span class="gy"></span></em></li>
          <li class="total"><span class="av av--4"><i class="ti ti-sparkles"></i></span><span><b>Lifetime value unlocked</b><small>Earning + saving since joining</small></span><em>$46.65</em></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ───────── Spots ───────── -->
  {featured.length > 0 && (
    <section class="section section--white">
      <div class="container">
        <div class="spots-head">
          <div>
            <span class="eyebrow">Explore</span>
            <h2 class="h2">Spots locals love</h2>
          </div>
          <a href="/businesses" class="btn btn--outline">See all local spots <i class="ti ti-arrow-right"></i></a>
        </div>
        <div class="spots">
          {featured.map((b) => (
            <a href={`/businesses/${b.slug}`} class="spot reveal">
              <div class="spot-img">
                <img src={sizedPhoto(b.photoUrl, 560, 420)} alt="" loading="lazy" referrerpolicy="no-referrer" />
                <span class="spot-cat"><i class:list={['ti', categoryIcon(b.category)]}></i>{b.googleCategory ?? b.category}</span>
              </div>
              <div class="spot-body">
                <strong>{b.name}</strong>
                <span>
                  {b.googleRating && <><i class="ti ti-star-filled"></i> {b.googleRating.toFixed(1)} · </>}
                  {b.city}
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ───────── For business ───────── -->
  <section class="section section--ink biz">
    <div class="container biz-grid">
      <div class="biz-copy reveal">
        <span class="eyebrow eyebrow--light"><span class="dot"></span>For local business</span>
        <h2 class="h2">Own your customers. <span class="hl-lime">For good.</span></h2>
        <p class="lede">
          A customer claims your offer, checks in, and taps to redeem. GOTYOU ties that visit back to the source — so you finally see what put a real person in your store. The customer is yours to keep. You pay for real visits, not impressions.
        </p>
        <ul class="biz-points">
          <li><i class="ti ti-users"></i><span><b>New customers, guaranteed</b>First-time visitors through your door every month, or we refund the rest.</span></li>
          <li><i class="ti ti-chart-dots-3"></i><span><b>Your Behavior Graph</b>Know who walks in, how often they come back, and what brings them in.</span></li>
          <li><i class="ti ti-nfc"></i><span><b>Tap to verify</b>Every redemption is confirmed at the counter. Never pay for a click, a bot, or a maybe.</span></li>
        </ul>
        <div class="biz-ctas">
          <a href="/pricing" class="btn btn--lime btn--lg">See pricing</a>
          <a href="/solution" class="btn btn--ghost btn--lg">How it works</a>
        </div>
      </div>
      <div class="biz-art reveal">
        <img src="/images/site/merchant_hero.jpg" alt="GOTYOU merchant dashboard: see who walked in, win them back" loading="lazy" class="merchant" />
        <img src="/images/site/puck.webp" alt="GOTYOU Counter Tap NFC pad: tap here, earn here" loading="lazy" class="puck float" />
      </div>
    </div>
  </section>

  <!-- ───────── Blog ───────── -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="spots-head">
          <div>
            <span class="eyebrow">The GOTYOU blog</span>
            <h2 class="h2">Notes from Main Street</h2>
          </div>
          <a href="/blog" class="btn btn--outline">All articles <i class="ti ti-arrow-right"></i></a>
        </div>
        <div class="posts">
          {posts.map((p) => (
            <a href={`/blog/${p.id}`} class="post card reveal">
              <div class="post-img">{p.data.heroImage && <img src={p.data.heroImage} alt="" loading="lazy" />}</div>
              <div class="post-body">
                <span class="chip">{p.data.tag}</span>
                <h3>{p.data.title}</h3>
                <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</BaseLayout>

<style>
  /* hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: 56px;
  }
  .hero::before {
    content: '';
    position: absolute;
    right: -10%;
    top: -20%;
    width: 70%;
    height: 120%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), transparent);
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 40px;
    align-items: center;
    min-height: 600px;
  }
  .hero-copy .display {
    font-size: clamp(38px, 4.9vw, 62px);
    margin: 10px 0 20px;
    text-shadow: 0 2px 30px rgba(10, 40, 110, 0.2);
  }
  .hero-copy .lede {
    color: rgba(255, 255, 255, 0.9);
    max-width: 540px;
    margin-bottom: 30px;
  }
  .explore-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 22px;
    font-weight: 600;
    color: #fff;
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 2px;
  }
  .explore-link:hover {
    border-color: var(--lime);
  }
  .hero-art {
    position: relative;
    align-self: end;
  }
  .hero-mockup {
    width: 112%;
    max-width: none;
    margin: 0 -6% -30px;
    filter: drop-shadow(0 30px 40px rgba(10, 40, 110, 0.25));
  }
  .bubble {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    color: var(--ink);
    border-radius: 20px;
    padding: 12px 18px 12px 12px;
    box-shadow: 0 18px 40px rgba(10, 40, 110, 0.25);
    font-size: 14px;
    z-index: 3;
  }
  .bubble b {
    display: block;
    line-height: 1.2;
  }
  .bubble small {
    color: var(--muted);
    font-size: 12.5px;
  }
  .bubble--earn {
    left: -4%;
    bottom: 34%;
  }
  .bubble--wallet {
    right: -2%;
    top: 8%;
  }
  .bubble--wallet i {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--grad-save);
    color: #fff;
    font-size: 22px;
  }
  .bubble--wallet b {
    font-size: 18px;
  }
  .plus {
    background: var(--grad-earn);
    color: #fff;
    font-weight: 800;
    border-radius: 14px;
    padding: 8px 10px;
    font-size: 18px;
  }
  .bubble--drop {
    right: 0;
    bottom: 12%;
  }
  .bubble--drop i {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--lime);
    font-size: 22px;
  }

  /* proof */
  .proof {
    background: var(--bg);
    padding: 8px 0 0;
  }
  .proof-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 22px 12px;
    box-shadow: var(--shadow-sm);
    text-align: center;
  }
  .proof-row div {
    display: flex;
    flex-direction: column;
  }
  .proof-row strong {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 800;
    color: var(--blue);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .proof-row span {
    font-size: 14px;
    color: var(--muted);
  }

  /* steps */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step {
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .step-shot {
    background: linear-gradient(180deg, #e3effc, #c9def6);
    min-height: 640px;
    padding: 32px 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  /* Official mockup, trimmed to the phone's edges: same width as the <Phone> frames (250px). */
  .mockup {
    width: min(250px, 74vw);
    height: auto;
    filter: drop-shadow(0 30px 40px rgba(15, 25, 60, 0.28));
  }
  .step-copy {
    padding: 26px 28px 30px;
  }
  .step-n {
    display: inline-block;
    font-weight: 800;
    font-size: 14px;
    color: var(--blue);
    background: var(--blue-50);
    border-radius: 100px;
    padding: 4px 12px;
    margin-bottom: 12px;
  }
  .step h3 {
    margin-bottom: 10px;
  }
  .step p {
    color: var(--muted);
  }

  /* drop */
  .drop {
    position: relative;
    overflow: hidden;
    padding-top: 96px;
  }
  .drop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    padding-bottom: 24px;
  }
  .drop-copy .h2 {
    margin: 8px 0 24px;
  }
  .drop-copy .lede {
    color: rgba(255, 255, 255, 0.9);
    margin: 26px 0 30px;
    max-width: 520px;
  }
  .drop-art {
    position: relative;
    min-height: 480px;
  }
  .neon {
    width: 88%;
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px rgba(10, 30, 90, 0.35);
  }
  .drop-art :global(.drop-phone) {
    position: absolute;
    right: 0;
    bottom: -20px;
  }

  /* status card */
  .love-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .status-card {
    background: linear-gradient(180deg, #e3effc 0%, #bcd5f2 100%);
    border-radius: var(--radius-lg);
    padding: 40px 28px 34px;
    text-align: center;
    max-width: 460px;
    margin: 0 auto;
    box-shadow: var(--shadow);
  }
  .status-ring {
    width: 190px;
    height: 190px;
    margin: 0 auto 20px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 40px rgba(242, 184, 36, 0.35);
  }
  .status-ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lvl {
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4a5168;
    font-size: 14px;
  }
  .lvl-title {
    font-size: 30px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 6px 0 26px;
  }
  .love {
    font-size: 26px;
    font-weight: 800;
    color: var(--blue);
    margin-bottom: 18px;
  }
  .actions {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    font-size: 15px;
    color: #4a5168;
    font-weight: 500;
  }
  .actions div {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .actions .ic {
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: #fff;
    border: 1px solid #c8daf2;
    display: grid;
    place-items: center;
    font-size: 28px;
    color: var(--blue);
  }
  .actions div:first-child .ic {
    color: #8b95ad;
  }
  .actions b {
    color: var(--blue);
    font-size: 24px;
    font-weight: 800;
  }
  .love-copy .h2 {
    margin-bottom: 18px;
  }
  .love-copy .lede + .lede {
    margin-top: 12px;
  }
  .ticks {
    list-style: none;
    margin-top: 28px;
    display: grid;
    gap: 14px;
  }
  .ticks li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-weight: 500;
  }
  .ticks i {
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blue-50);
    color: var(--blue);
    font-size: 18px;
  }

  /* wallet */
  .wallet-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .wallet-copy .h2 {
    margin-bottom: 18px;
  }
  .wallet-copy .lede {
    margin-bottom: 30px;
  }
  .wallet-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .wcard {
    border-radius: var(--radius);
    padding: 26px 24px;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 2px;
    box-shadow: var(--shadow);
  }
  .wcard--earn {
    background: var(--grad-earn);
  }
  .wcard--save {
    background: var(--grad-save);
  }
  .wl {
    display: flex;
    gap: 8px;
    align-items: center;
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  .wcard strong {
    font-size: 44px;
