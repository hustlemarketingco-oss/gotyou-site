---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const featuredBusinesses = (await getCollection('businesses'))
  .sort((a, b) => b.data.checkinCount - a.data.checkinCount)
  .slice(0, 2);
---

<BaseLayout title="GOTYOU" description="Discover, connect, and unlock exclusive rewards at local businesses. Earn cash, perks, and elevate your status — all in one free app.">
  <div class="hero">
    <div class="hero-inner">
      <div>
        <div class="eyebrow">
          <span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span>
          Empowering Digital First Consumers
        </div>
        <h1>Unleash Limitless Savings, Discover New Possibilities</h1>
        <p class="hero-sub">Discover, connect, and unlock exclusive rewards. Earn cash, perks, and elevate your status at your favorite local hotspots—all while supporting the businesses you love.</p>
        <div class="hero-ctas">
          <a href="/download" class="btn-primary">
            Get Started
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" style="vertical-align:-2px"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>
          </a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="hero-card">
          <img src="/images/check-in-salon.png" alt="Checking in on GOTYOU" />
        </div>
        <div class="floating-token t1"><span class="token-icon">G</span> $GET earned</div>
        <div class="floating-token t2">
          <span class="token-icon"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 11a3 3 0 106 0 3 3 0 00-6 0z" /><path d="M12 21s-7-6.5-7-11a7 7 0 1114 0c0 4.5-7 11-7 11z" /></svg></span>
          Sample business
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-eyebrow">How GOTYOU works</span>
        <h2 class="section-title">Download the free app</h2>
        <p class="section-sub">Local Savings and Connection, Simplified — At GOTYOU, our free app connects you with local merchants effortlessly—no email lists, no spam.</p>
      </div>
      <div class="benefits">
        <div class="benefit">
          <div class="benefit-circles"></div>
          <div class="benefit-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" /><circle cx="12" cy="10" r="3" /></svg></div>
          <h3>Check In and Earn Instantly</h3>
          <p>Every time you visit, simply refresh the GOTYOU app, select the merchant, and hit Check-In—you'll instantly earn a cash reward for supporting your favorite local spots!</p>
          <div class="trail-mini"><span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span></div>
        </div>
        <div class="benefit">
          <div class="benefit-circles"></div>
          <div class="benefit-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg></div>
          <h3>Earn Status, Perks, and Rewards with Every Visit</h3>
          <p>After checking in, take it further—leave feedback, answer a quick survey, or refer a friend. Every action earns you $GET points, our universal rewards currency, which you can cash out or use to support more local businesses in the GOTYOU network.</p>
          <div class="trail-mini"><span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span></div>
        </div>
        <div class="benefit">
          <div class="benefit-circles"></div>
          <div class="benefit-icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l1-5h16l1 5" /><path d="M3 9h18v11H3z" /><path d="M9 13a3 3 0 006 0" /></svg></div>
          <h3>Save Big on Everyday Purchases</h3>
          <p>Dine out, shop, or catch a movie—and save at thousands of local businesses. GOTYOU turns your everyday spending into real rewards. Stop juggling multiple apps, emails, SMS messages, or pesky coupons.</p>
          <div class="trail-mini"><span class="token-trail"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="dot"></span></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="section" style="padding-top: 0;">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-eyebrow">See it in action</span>
        <h2 class="section-title">Watch How GOTYOU Works</h2>
      </div>
      <div class="video-embed">
        <iframe
          src="https://www.youtube.com/embed/xA9o9abv2og"
          title="GOTYOU — See how it works"
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>

  <div class="section" style="padding-top: 0;">
    <div class="section-inner">
      <div class="token-strip">
        <div class="token-strip-content">
          <span class="section-eyebrow" style="margin-bottom: 10px;">$GET tokens</span>
          <h2>Stop juggling multiple apps, emails, SMS messages, or pesky coupons</h2>
          <p>With $GET tokens, you can earn instantly and spend them at your favorite local spots. Real savings, real rewards, all in one app.</p>
        </div>
        <div style="position: relative; z-index: 1;">
          <img src="/images/gotyou-rewards.png" alt="GOTYOU $GET points wallet" style="width: 100%; border-radius: 16px; display: block;" />
        </div>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-inner">
      <div class="section-head">
        <span class="section-eyebrow" style="display: flex; align-items: center; justify-content: center; gap: 8px;">New feature preview <span class="new-tag" style="font-size: 9px;">new</span></span>
        <h2 class="section-title">Businesses already on GOTYOU</h2>
        <p class="section-sub">A directory feature in development — sample listings shown for layout purposes.</p>
      </div>
      <div class="biz-grid">
        {
          featuredBusinesses.map((biz) => (
            <a href={`/businesses/${biz.data.slug}`} class="biz-card">
              <div class="biz-img">
                <img src={biz.data.slug.startsWith('firehouse') ? '/images/redeem-tokens.png' : '/images/check-in-salon.png'} alt={biz.data.name} />
                {biz.data.claimStatus === 'claimed' ? (
                  <div class="biz-badge"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" style="vertical-align:-2px"><polyline points="20 6 9 17 4 12" /></svg> Verified</div>
                ) : (
                  <div class="biz-badge" style="border-color: rgba(255,255,255,0.2); color: var(--text-dim);"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><circle cx="12" cy="12" r="9" /><line x1="12" y1="8" x2="12" y2="13" /><line x1="12" y1="16" x2="12" y2="16.01" /></svg> Unclaimed</div>
                )}
              </div>
              <div class="biz-body">
                <h4>{biz.data.name}</h4>
                <div class="cat">{biz.data.category} · {biz.data.city}</div>
                <div class="biz-foot">
                  <div class="checkins"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px"><path d="M9 11a3 3 0 106 0 3 3 0 00-6 0z" /><path d="M12 21s-7-6.5-7-11a7 7 0 1114 0c0 4.5-7 11-7 11z" /></svg> {biz.data.checkinCount} check-ins</div>
                </div>
              </div>
            </a>
          ))
        }
        <div class="biz-card">
          <div class="biz-img">
            <img src="/images/check-in-salon.png" alt="Placeholder card" />
            <div class="biz-badge" style="border-color: rgba(255,255,255,0.2); color: var(--text-dim);">Placeholder</div>
          </div>
          <div class="biz-body">
            <h4>Your business here</h4>
            <div class="cat">Card layout placeholder</div>
            <div class="biz-foot"><div class="checkins" style="color: var(--text-dimmer);">Real data once seeded</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
