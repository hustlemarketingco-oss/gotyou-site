---
// Personal earnings calculator — same model as gotyou.co/roi-user: per weekly visit you earn
// 1 token for a check-in, 2 for feedback, 5 for a 3-question survey, 10 for referring a friend to
// the business; referring 10 friends to GOTYOU is a one-off 100 tokens a week. Month = 4.33 weeks.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { TOKEN_VALUE_USD } from '../lib/constants';

const visits = [
  { name: 'eat', label: 'Times you eat out each week', value: 3 },
  { name: 'delivery', label: 'Food deliveries each week', value: 2 },
  { name: 'retail', label: 'Other store visits each week', sub: 'Retail, convenience stores, etc.', value: 4 },
  { name: 'venues', label: 'Other venues each week', sub: 'Movies, bars, sporting events, etc.', value: 1 },
];
const actions = [
  { name: 'checkin', label: 'Check in', tokens: 1, on: true },
  { name: 'feedback', label: 'Give feedback (1–5 stars)', tokens: 2, on: true },
  { name: 'survey', label: 'Take a 3-question survey', tokens: 5, on: false },
  { name: 'refer', label: 'Refer a friend to the business', tokens: 10, on: false },
  { name: 'refer10', label: 'Refer 10 friends to GOTYOU', tokens: 100, on: false, weekly: true },
];
---

<BaseLayout title="Earnings calculator" description="See how much you could earn with GOTYOU for checking in, leaving feedback, and taking surveys at the local spots you already visit.">
  <PageHero eyebrow="Earnings calculator" title="Give your wallet a <em>big boost.</em>" lede="Not Google’s wallet — yours. Earn for checking in, leaving feedback, or taking surveys when you dine out and shop local." />

  <section class="section">
    <div class="container calc" id="earn-calc" data-token={TOKEN_VALUE_USD}>
      <form class="card card--pad" onsubmit="return false">
        <label class="name">Your first name (optional)
          <input type="text" name="first" autocomplete="given-name" placeholder="Alex" />
        </label>
        <h2 class="h3">Your week</h2>
        {visits.map((v) => (
          <label class="row">
            <span>{v.label}{v.sub && <small>{v.sub}</small>}</span>
            <input type="number" name={v.name} min="0" max="50" value={v.value} inputmode="numeric" />
          </label>
        ))}
        <h2 class="h3">What would you do if you got paid?</h2>
        <div class="acts">
          {actions.map((a) => (
            <label class="act">
              <input type="checkbox" name={a.name} data-tokens={a.tokens} data-weekly={a.weekly ? '1' : ''} checked={a.on} />
              <span>{a.label}</span>
              <em>+{a.tokens}</em>
            </label>
          ))}
        </div>
      </form>

      <div class="results">
        <div class="wallet">
          <p class="who" data-title>Your earning potential</p>
          <div class="ring">
            <div class="ring-in">
              <strong data-out="year">$0</strong>
              <span>a year</span>
            </div>
          </div>
          <div class="periods">
            <div><span>Weekly</span><b data-out="week">$0</b><small data-out="weekT">0 tokens</small></div>
            <div><span>Monthly</span><b data-out="month">$0</b><small data-out="monthT">0 tokens</small></div>
            <div><span>Yearly</span><b data-out="year2">$0</b><small data-out="yearT">0 tokens</small></div>
          </div>
        </div>
        <p class="fine">
          Your earning potential will vary depending on the number of active merchants and the tasks you complete. Not all local businesses are on GOTYOU yet, but the number is growing daily — refer businesses to join for extra earning potential.
        </p>
        <div class="card card--pad get">
          <h2 class="h3">Start earning today</h2>
          <StoreBadges />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.getElementById('earn-calc')!;
  const f = root.querySelector('form')!;
  const value = parseFloat(root.dataset.token || '0.1');
  const out = (k: string, v: string) => root.querySelectorAll(`[data-out="${k}"]`).forEach((n) => (n.textContent = v));
  const money = (n: number) => '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const num = (name: string) => parseInt((f.elements.namedItem(name) as HTMLInputElement).value) || 0;

  function calc() {
    const visits = num('eat') + num('delivery') + num('retail') + num('venues');
    let tokens = 0;
    f.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((c) => {
      if (!c.checked) return;
      const t = parseInt(c.dataset.tokens || '0');
      tokens += c.dataset.weekly ? t : visits * t;
    });
    const week = tokens * value;
    out('week', money(week));
    out('month', money(week * 4.33));
    out('year', money(week * 52));
    out('year2', money(week * 52));
    out('weekT', `${Math.round(tokens).toLocaleString()} tokens`);
    out('monthT', `${Math.round(tokens * 4.33).toLocaleString()} tokens`);
    out('yearT', `${Math.round(tokens * 52).toLocaleString()} tokens`);
    const first = (f.elements.namedItem('first') as HTMLInputElement).value.trim();
    root.querySelector('[data-title]')!.textContent = first ? `${first}’s earning potential` : 'Your earning potential';
  }
  f.addEventListener('input', calc);
  calc();
</script>

<style>
  .calc {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: 28px;
    align-items: start;
  }
  form {
    display: grid;
    gap: 16px;
  }
  form .h3 {
    margin-top: 10px;
  }
  label {
    font-weight: 600;
  }
  .name {
    display: grid;
    gap: 8px;
  }
  input[type='text'],
  input[type='number'] {
    font: 500 16px var(--font);
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--text);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-weight: 500;
  }
  .row small {
    display: block;
    color: var(--muted);
    font-size: 13px;
    font-weight: 400;
  }
  .row input {
    width: 96px;
    text-align: center;
  }
  .acts {
    display: grid;
    gap: 10px;
  }
  .act {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: 16px;
    cursor: pointer;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s;
  }
  .act:has(input:checked) {
    border-color: var(--blue);
    background: var(--blue-50);
  }
  .act input {
    width: 20px;
    height: 20px;
    accent-color: var(--blue);
  }
  .act em {
    margin-left: auto;
    font-style: normal;
    font-weight: 700;
    color: var(--blue);
  }
  .results {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 16px;
  }
  .wallet {
    border-radius: var(--radius-lg);
    padding: 30px 24px;
    background: linear-gradient(180deg, #d9f0fb 0%, #ffffff 70%);
    border: 1px solid var(--line);
    text-align: center;
    box-shadow: var(--shadow);
  }
  .who {
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 16px;
  }
  .ring {
    width: 230px;
    aspect-ratio: 1;
    margin: 0 auto 22px;
    border-radius: 50%;
    padding: 14px;
    background: var(--grad-ring);
    box-shadow: 0 0 40px rgba(228, 255, 26, 0.6);
  }
  .ring-in {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 60%, #eef7fd);
    display: grid;
    place-content: center;
  }
  .ring-in strong {
    font-size: 36px;
    font-weight: 800;
    color: #233e8f;
    letter-spacing: -0.02em;
  }
  .ring-in span {
    font-weight: 600;
    color: #233e8f;
  }
  .periods {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .periods div {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 12px 6px;
    display: grid;
  }
  .periods span {
    font-size: 13px;
    color: var(--muted);
  }
  .periods b {
    font-size: 18px;
  }
  .periods small {
    font-size: 11.5px;
    color: var(--muted);
  }
  .fine {
    font-size: 13px;
    color: var(--muted);
  }
  .get {
    display: grid;
    gap: 14px;
  }
  @media (max-width: 900px) {
    .calc {
      grid-template-columns: 1fr;
    }
    .results {
      position: static;
    }
  }
</style>
