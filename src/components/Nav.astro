---
import { NAV_LINKS, BRAND } from '../lib/constants';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : !href.includes('#') && currentPath.startsWith(href));
---

<header class="site-nav">
  <nav class="container bar" aria-label="Main">
    <a href="/" class="logo" aria-label={`${BRAND.name} home`}>
      <img src="/images/brand/gotyou-logo-blue.png" alt={BRAND.name} width="62" height="40" />
    </a>

    <div class="links" id="nav-menu">
      {NAV_LINKS.map((l) => <a href={l.href} class:list={[isActive(l.href) && 'active']}>{l.label}</a>)}
      <div class="more-links">
        <a href="/1123">11:23 Daily Drop</a>
        <a href="/where-gotyou-works">Where we work</a>
        <a href="/careers">Careers</a>
        <a href="/faq">FAQ</a>
        <a href="/contact">Contact</a>
      </div>
      <div class="menu-actions">
        <a href={BRAND.appUrl} class="login">Merchant login</a>
        <a href="/download" class="btn btn--primary get">Get the app</a>
      </div>
    </div>

    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('.site-nav');
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  function setOpen(open: boolean) {
    menu?.classList.toggle('open', open);
    header?.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    document.body.style.overflow = open ? 'hidden' : '';
  }
  toggle?.addEventListener('click', () => setOpen(!menu?.classList.contains('open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 200;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .site-nav.scrolled {
    border-bottom-color: var(--line);
    box-shadow: 0 6px 24px rgba(20, 24, 51, 0.06);
  }
  /* backdrop-filter makes the header the containing block for position:fixed children, which
     trapped the mobile menu inside the 74px bar. Drop it (and go opaque) while the menu is open. */
  .site-nav.menu-open {
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    background: #fff;
  }
  .bar {
    height: 74px;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .logo img {
    height: 40px;
    width: auto;
  }
  .links {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .links > a {
    padding: 9px 14px;
    border-radius: 100px;
    font-size: 15px;
    font-weight: 500;
    color: #39415e;
    transition: background 0.15s, color 0.15s;
  }
  .links > a:hover {
    background: var(--blue-50);
    color: var(--blue);
  }
  .links > a.active {
    color: var(--blue);
    font-weight: 600;
  }
  .more-links {
    display: none;
  }
  .menu-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .login {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .login:hover {
    color: var(--blue);
  }
  .get {
    padding: 11px 22px;
    font-size: 15px;
    box-shadow: none;
  }

  .nav-toggle {
    display: none;
    margin-left: auto;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: #fff;
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .nav-toggle span {
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.2s, opacity 0.2s;
  }
  .menu-open .nav-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .menu-open .nav-toggle span:nth-child(2) {
    opacity: 0;
  }
  .menu-open .nav-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 960px) {
    .nav-toggle {
      display: flex;
    }
    .links {
      position: fixed;
      inset: 74px 0 0 0;
      z-index: 199;
      height: calc(100dvh - 74px);
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      padding: 18px 16px 32px;
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.2s, transform 0.2s, visibility 0.2s;
      overflow-y: auto;
    }
    .links.open {
      opacity: 1;
      transform: none;
      visibility: visible;
    }
    .links > a {
      font-size: 20px;
      font-weight: 600;
      padding: 14px 12px;
      border-radius: 14px;
    }
    .more-links {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
      padding-top: 18px;
      border-top: 1px solid var(--line);
    }
    .more-links a {
      padding: 9px 14px;
      border-radius: 100px;
      background: var(--blue-50);
      color: var(--blue);
      font-weight: 600;
      font-size: 14.5px;
    }
    .menu-actions {
      margin: 18px 0 0;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 14px;
      text-align: center;
    }
    .get {
      padding: 16px;
      font-size: 17px;
    }
  }
</style>
