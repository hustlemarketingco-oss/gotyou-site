---
import { NAV_LINKS, BRAND } from '../lib/constants';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav>
  <a href="/" class="logo" aria-label={`${BRAND.name} home`}>
    <span class="lc">G</span><span class="lc">O</span><span class="lc">T</span>
    <span class="lc">Y</span><span class="lc">O</span><span class="lc">U</span>
  </a>

  <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>

  <div class="nav-right" id="nav-menu">
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
          {link.label}
        </a>
      ))
    }
    <a href={BRAND.appUrl} class="nav-login">Merchant Login</a>
  </div>
</nav>

<style>
  nav {
    background: var(--blue);
    height: 66px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 2.5rem;
    position: sticky;
    top: 0;
    z-index: 200;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  /* Logo: 6 white circles, 3x2 grid, black letters — matches the real GotYou mark */
  .logo {
    display: inline-grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    cursor: pointer;
  }
  .lc {
    width: 21px;
    height: 21px;
    border-radius: 50%;
    background: #fff;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 10px;
    line-height: 1;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-right a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-weight: 500;
    font-family: var(--font-display);
    transition: color 0.2s;
  }
  .nav-right a:hover,
  .nav-right a.active {
    color: #fff;
  }
  .nav-login {
    background: var(--yellow);
    color: #000 !important;
    padding: 9px 20px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 700 !important;
    transition: background 0.2s;
  }
  .nav-login:hover {
    background: var(--yellow-2);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: flex;
    }

    .nav-right {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: var(--blue);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
      box-shadow: 0 8px 12px rgba(0, 0, 0, 0.15);
    }
    .nav-right.open {
      max-height: calc(100vh - 66px);
      overflow-y: auto;
      padding: 0.5rem 0 1.25rem;
    }
    .nav-right a {
      padding: 0.85rem 2.5rem;
    }
    .nav-right a.nav-login {
      margin: 0.5rem 2.5rem 0;
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  function closeMenu() {
    menu?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
