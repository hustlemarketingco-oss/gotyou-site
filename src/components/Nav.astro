---
import { NAV_LINKS, BRAND } from '../lib/constants';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav>
  <a href="/" class="logo-wrap" aria-label={`${BRAND.name} home`}>
    <img src="/images/got-you-logo.png" alt={`${BRAND.name} logo`} />
  </a>

  <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-menu" aria-label="Open menu">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>

  <div class="nav-links" id="nav-menu">
    {
      NAV_LINKS.map((link) => (
        <a href={link.href} class={isActive(link.href) ? 'active' : ''}>
          {link.label}
        </a>
      ))
    }
    <a href="/businesses" class="nav-new">Businesses <span class="new-tag">new</span></a>
    <a href={BRAND.appUrl} class="nav-cta">Merchant Login</a>
  </div>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 4rem;
    position: sticky;
    top: 0;
    background: rgba(11, 16, 41, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 200;
  }

  /* Logo PNG ships with an opaque white background (no alpha), so the chip
     just rounds its corners rather than floating a raw white rectangle on
     the dark nav. */
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border-radius: 8px;
    padding: 5px 10px;
  }
  .logo-wrap img {
    height: 32px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 2.2rem;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 500;
    color: var(--text-dim);
    transition: color 0.2s;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: #fff;
  }
  .nav-new {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-cta {
    background: var(--yellow);
    color: #0b1029 !important;
    padding: 10px 22px;
    border-radius: 100px;
    font-weight: 700 !important;
  }
  .nav-cta:hover {
    background: var(--yellow-2);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 860px) {
    nav {
      padding: 16px 1.5rem;
    }
    .nav-toggle {
      display: flex;
    }

    .nav-links {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #0b1029;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
      box-shadow: 0 8px 12px rgba(0, 0, 0, 0.3);
    }
    .nav-links.open {
      max-height: calc(100vh - 66px);
      overflow-y: auto;
      padding: 0.5rem 0 1.25rem;
    }
    .nav-links a {
      padding: 0.85rem 2.5rem;
    }
    .nav-links a.nav-cta,
    .nav-links a.nav-new {
      margin: 0.5rem 2.5rem 0;
    }
    .nav-links a.nav-cta {
      text-align: center;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const menu = document.getElementById('nav-menu');

  function closeMenu() {
    menu?.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    toggle?.setAttribute('aria-label', 'Open menu');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
