---
// A real GOTYOU app screenshot inside a simple phone frame.
interface Props {
  src: string;
  alt: string;
  width?: number;
  tilt?: number;
  class?: string;
  eager?: boolean;
}
const { src, alt, width = 280, tilt = 0, class: cls, eager = false } = Astro.props;
---

<figure class:list={['phone', cls]} style={`--w:${width}px; --tilt:${tilt}deg`}>
  <div class="screen">
    <img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
</figure>

<style>
  .phone {
    width: min(var(--w), 78vw);
    aspect-ratio: 9 / 19;
    padding: 10px;
    border-radius: 44px;
    background: linear-gradient(145deg, #2a2f4a, #0f1226);
    box-shadow:
      0 30px 70px rgba(20, 24, 51, 0.32),
      inset 0 0 0 2px rgba(255, 255, 255, 0.08);
    transform: rotate(var(--tilt));
    position: relative;
    flex: none;
  }
  .phone::before {
    content: '';
    position: absolute;
    top: 18px;
    left: 50%;
    width: 30%;
    height: 22px;
    transform: translateX(-50%);
    background: #0f1226;
    border-radius: 100px;
    z-index: 2;
  }
  .screen {
    width: 100%;
    height: 100%;
    border-radius: 35px;
    overflow: hidden;
    background: #fff;
  }
  .screen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
</style>
