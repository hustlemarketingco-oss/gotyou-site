---
import { BRAND } from '../lib/constants';
const year = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <a href="/" class="logo-wrap" aria-label={`${BRAND.name} home`}>
      <img src="/images/got-you-logo.png" alt={`${BRAND.name} logo`} />
    </a>
    <p>© {year} {BRAND.name}, Co All Rights Reserved</p>
  </div>
</footer>

<style>
  footer {
    padding: 2.5rem 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .logo-wrap {
    display: inline-flex;
    align-items: center;
    background: #fff;
    border-radius: 6px;
    padding: 4px 8px;
  }
  .logo-wrap img {
    height: 18px;
    width: auto;
    display: block;
  }
  footer p {
    color: var(--text-dimmer);
    font-size: 12.5px;
  }

  @media (max-width: 640px) {
    footer {
      padding: 2rem 1.5rem;
    }
  }
</style>
