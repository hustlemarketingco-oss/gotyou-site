---
import { BRAND, FOOTER_LINKS, LEGAL_LINKS, SOCIAL_LINKS } from '../lib/constants';
import StoreBadges from './StoreBadges.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="top">
      <div class="brand">
        <a href="/" aria-label={`${BRAND.name} home`}><img src="/images/brand/gotyou-logo-white-sm.webp" alt={BRAND.name} width="74" height="48" loading="lazy" /></a>
        <p>{BRAND.promise}</p>
        <StoreBadges />
        <div class="social">
          {SOCIAL_LINKS.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><i class:list={['ti', s.icon]}></i></a>
          ))}
        </div>
      </div>
      {FOOTER_LINKS.map((col) => (
        <div class="col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href} {...(l.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="bottom">
      <p>© {year} {BRAND.name}, Co. All rights reserved. · <a href={`mailto:${BRAND.supportEmail}`}>{BRAND.supportEmail}</a></p>
      <nav aria-label="Legal">
        {LEGAL_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.72);
    padding: 64px 0 32px;
    font-size: 15px;
  }
  .top {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 48px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .brand img {
    height: 48px;
    width: auto;
    margin-bottom: 16px;
  }
  .brand p {
    max-width: 320px;
    margin-bottom: 22px;
    color: rgba(255, 255, 255, 0.82);
  }
  .brand :global(.badges img) {
    height: 42px;
  }
  .social {
    display: flex;
    gap: 10px;
    margin-top: 22px;
  }
  .social a {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    font-size: 19px;
    color: #fff;
    transition: background 0.15s, color 0.15s;
  }
  .social a:hover {
    background: var(--lime);
    color: var(--ink);
  }
  h3 {
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    margin-bottom: 16px;
  }
  ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  ul a:hover,
  .bottom a:hover {
    color: var(--lime);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 14px;
    padding-top: 26px;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.55);
  }
  .bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }
  @media (max-width: 900px) {
    .top {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 480px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
