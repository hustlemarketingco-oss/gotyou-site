---
// Inner-page hero: the app's sky-blue gradient with the skyline as its ground line.
import Skyline from './Skyline.astro';

interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  ground?: string; // colour of the section below, so the skyline blends into it
  align?: 'center' | 'left';
}
const { eyebrow, title, lede, ground = 'var(--bg)', align = 'center' } = Astro.props;
---

<section class:list={['page-hero sky', `page-hero--${align}`]}>
  <div class="container inner">
    <div class="copy">
      {eyebrow && <span class="eyebrow eyebrow--pill"><span class="dot"></span>{eyebrow}</span>}
      <h1 class="display" set:html={title} />
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
    <slot name="aside" />
  </div>
  <Skyline fill={ground} />
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-top: 72px;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% auto auto;
    width: 60%;
    height: 90%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.22), transparent);
    pointer-events: none;
  }
  .inner {
    position: relative;
    display: flex;
    gap: 48px;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 8px;
  }
  .page-hero--center .inner {
    justify-content: center;
    text-align: center;
  }
  .page-hero--center .copy {
    max-width: 820px;
  }
  .page-hero--left .copy {
    max-width: 640px;
  }
  .display {
    font-size: clamp(36px, 5.4vw, 62px);
    margin: 6px 0 18px;
    text-shadow: 0 2px 24px rgba(10, 40, 110, 0.18);
  }
  .display :global(em) {
    font-style: normal;
    color: var(--lime);
  }
  .lede {
    color: rgba(255, 255, 255, 0.88);
    max-width: 640px;
  }
  .page-hero--center .lede {
    margin: 0 auto;
  }
  @media (max-width: 860px) {
    .inner {
      flex-direction: column;
    }
    .page-hero {
      padding-top: 48px;
    }
  }
</style>
