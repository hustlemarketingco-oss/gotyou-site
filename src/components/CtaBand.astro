---
// Closing "get the app" band, using the app wallet's tagline and gradient ring.
import StoreBadges from './StoreBadges.astro';
import Skyline from './Skyline.astro';

interface Props {
  title?: string;
  lede?: string;
}
const {
  title = 'Live the city life. <span class="grad-text">It pays you back.</span>',
  lede = 'Download GOTYOU free. Something new drops every day at 11:23.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container inner reveal">
    <div class="ring" aria-hidden="true">
      <img src="/images/site/mascot-explorer.jpg" alt="" loading="lazy" />
    </div>
    <div class="copy">
      <h2 class="h2" set:html={title} />
      <p class="lede">{lede}</p>
      <StoreBadges size="lg" />
    </div>
  </div>
  <Skyline fill="var(--ink)" back="rgba(31,107,214,0.16)" />
</section>

<style>
  .cta-band {
    background: linear-gradient(180deg, #ffffff 0%, #e3effc 100%);
    padding-top: 96px;
    overflow: hidden;
  }
  .inner {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 56px;
    align-items: center;
    max-width: 1000px;
  }
  .ring {
    width: 300px;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 14px;
    background: var(--grad-ring);
    box-shadow: 0 0 60px rgba(228, 255, 26, 0.55);
    display: grid;
    place-items: center;
  }
  .ring img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .h2 {
    color: var(--ink);
    margin-bottom: 14px;
  }
  .lede {
    margin-bottom: 26px;
  }
  @media (max-width: 760px) {
    .inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 32px;
    }
    .ring {
      width: 220px;
      margin: 0 auto;
    }
    .copy :global(.badges) {
      justify-content: center;
    }
  }
</style>
