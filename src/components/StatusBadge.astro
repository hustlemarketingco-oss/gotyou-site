---
interface Props {
  status: 'unclaimed' | 'pending' | 'claimed';
  size?: 'sm' | 'md';
}

const { status, size = 'md' } = Astro.props;

const copy = {
  unclaimed: { label: 'Unclaimed', icon: 'ti-alert-circle' },
  pending: { label: 'Claim In Review', icon: 'ti-clock' },
  claimed: { label: 'Verified on GOTYOU', icon: 'ti-check' },
}[status];
---

<span class:list={['badge', status, size]}>
  <i class={`ti ${copy.icon}`} />
  {copy.label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    border-radius: 20px;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge.sm {
    position: absolute;
    top: 10px;
    right: 10px;
    padding: 4px 10px;
    font-size: 11px;
  }
  .badge.md {
    padding: 6px 14px;
    font-size: 13px;
  }

  .badge.unclaimed {
    background: #fff3eb;
    color: #c2530f;
  }
  .badge.pending {
    background: #fff8e1;
    color: #9a7600;
  }
  .badge.claimed {
    background: #e6f9ee;
    color: #15803d;
  }

  /* On the small/card variant, unclaimed should read clearly against the blue image background */
  .badge.sm.unclaimed {
    background: #ff6b2b;
    color: #fff;
  }
  .badge.sm.claimed {
    background: var(--green);
    color: #fff;
  }
  .badge.sm.pending {
    background: var(--yellow);
    color: #000;
  }
</style>
