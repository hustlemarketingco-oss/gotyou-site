---
// The one interactive piece of the directory. The default view (popular spots in each area, grouped by
// state) is rendered on the server for a fast first paint and crawlable links; the full search index is a
// static file (/businesses/search.json, see search.json.ts) fetched once and filtered with vanilla JS.
// Past ~20k businesses, swap this for a Cloudflare Worker search endpoint.
//
// Location: the page opens on the visitor's area when we can tell where they are — first from a choice they
// made before (localStorage), then from Cloudflare's IP lookup (/api/geo, no permission prompt), or precisely
// from the browser when they press "Use my location". Visitors outside every area get the grouped view.
//
// The search input (#searchInput), location select (#cityFilter), locate button and note live in the page
// hero; this component owns the category pills, sorting, the card grid and paging. Filters are mirrored to
// the URL (?q=&city=&cat=&sort=) so a filtered view can be linked and survives back/forward.
import { CATEGORY_ICONS } from '../lib/business';

export interface BusinessSearchEntry {
  slug: string;
  name: string;
  category: string;
  googleCategory: string;
  city: string;
  state: string;
  address: string;
  claimStatus: 'unclaimed' | 'pending' | 'claimed';
  rating: number;
  reviews: number;
  price: string;
  photo: string;
  area: string;
}

export interface DirectoryArea {
  name: string;
  state: string;
  stateName: string;
  count: number;
  cities: string[];
}

interface Props {
  businesses: BusinessSearchEntry[];
  areas: DirectoryArea[];
}

const { businesses, areas } = Astro.props;
const GROUP = 8;
// "Recommended": GOTYOU partners first, then rating weighted by review volume (same order as the client script).
const popularity = (b: BusinessSearchEntry) => (b.claimStatus === 'claimed' ? 100 : 0) + (b.rating ? b.rating * Math.log10(b.reviews + 10) : 0);
const groups = areas.map((a) => ({
  ...a,
  top: businesses.filter((b) => b.area === a.name).sort((x, y) => popularity(y) - popularity(x)).slice(0, GROUP),
}));
const counts = businesses.reduce<Record<string, number>>((acc, b) => ((acc[b.category] = (acc[b.category] ?? 0) + 1), acc), {});
const categories = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
const cityArea = Object.fromEntries(areas.flatMap((a) => a.cities.map((c) => [c, a.name])));
const areaData = { areas: areas.map(({ name, state, stateName, count }) => ({ name, state, stateName, count })), cityArea };
---

<section class="dir-body">
  <div class="dir-inner">
    <div class="toolbar">
      <div class="pills" id="categoryPills" role="group" aria-label="Category">
        <button class="pill active" data-cat="All" aria-pressed="true"><i class="ti ti-layout-grid"></i>All <span class="n">{businesses.length}</span></button>
        {categories.map((c) => (
          <button class="pill" data-cat={c} aria-pressed="false">
            <i class:list={['ti', CATEGORY_ICONS[c] ?? 'ti-building-store']}></i>{c} <span class="n">{counts[c]}</span>
          </button>
        ))}
      </div>
      <div class="toolbar-row">
        <div class="result-count" id="resultCount" aria-live="polite">
          <strong>{businesses.length.toLocaleString()}</strong> places in {areas.length} {areas.length === 1 ? 'area' : 'areas'}
        </div>
        <label class="sort">
          Sort
          <select id="sortSelect">
            <option value="popular">Recommended</option>
            <option value="rating">Top rated</option>
            <option value="name">A–Z</option>
          </select>
        </label>
      </div>
    </div>

    <div class="grid grouped" id="bizGrid">
      {groups.map((g) => (
        <section class="group">
          <div class="group-head">
            <div>
              <span class="group-state">{g.stateName}</span>
              <h2>Popular in {g.name}, {g.state}</h2>
            </div>
            <a class="see-all" href={`/businesses/?city=${encodeURIComponent(`area:${g.name}`)}`} data-loc={`area:${g.name}`}>
              See all {g.count.toLocaleString()} <i class="ti ti-arrow-right"></i>
            </a>
          </div>
          <div class="group-grid">
            {g.top.map((b) => {
              const icon = CATEGORY_ICONS[b.category] ?? 'ti-building-store';
              return (
                <a href={`/businesses/${b.slug}`} class="card">
                  <div class="photo">
                    <span class="ph"><i class:list={['ti', icon]}></i></span>
                    {b.photo && <img src={b.photo} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />}
                    <span class="chip"><i class:list={['ti', icon]}></i>{b.category}</span>
                    {b.claimStatus === 'claimed' && <span class="badge badge--on"><i class="ti ti-circle-check-filled"></i> On GOTYOU</span>}
                  </div>
                  <div class="body">
                    <h3>{b.name}</h3>
                    <div class="sub">{b.googleCategory}{b.price ? ` · ${b.price}` : ''}</div>
                    <div class="foot">
                      {b.rating ? <span class="rating"><i class="ti ti-star-filled"></i>{b.rating.toFixed(1)}<span class="cnt">({b.reviews.toLocaleString()})</span></span> : <span class="rating rating--none">No reviews yet</span>}
                      <span class="loc"><i class="ti ti-map-pin"></i>{b.city}</span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </div>
    <div class="more-wrap"><button class="more" id="loadMore" hidden>Show more</button></div>
  </div>
</section>

<script type="application/json" id="categoryIcons" set:html={JSON.stringify(CATEGORY_ICONS)} />
<script type="application/json" id="areaData" set:html={JSON.stringify(areaData)} />

<script>
  type Biz = {
    slug: string;
    name: string;
    category: string;
    googleCategory: string;
    city: string;
    state: string;
    address: string;
    claimStatus: 'unclaimed' | 'pending' | 'claimed';
    rating: number;
    reviews: number;
    price: string;
    photo: string;
    lat: number | null;
    lng: number | null;
    approx?: boolean; // no coordinates of its own; placed at the middle of its city
    area: string;
  };
  type Area = { name: string; state: string; stateName: string; count: number };
  type Spot = { lat: number; lng: number; precise: boolean; label: string };

  const PAGE = 24;
  const GROUP = 8;
  const NEAR_KM = 40; // "Near me" shows listings within ~25 miles
  const SERVED_KM = 60; // closer than this to any listing counts as being in one of our areas
  const SAVE_KEY = 'gotyou-dir-location';

  const { areas: AREAS, cityArea: CITY_AREA } = JSON.parse(document.getElementById('areaData')?.textContent || '{}') as {
    areas: Area[];
    cityArea: Record<string, string>;
  };
  const ICONS: Record<string, string> = JSON.parse(document.getElementById('categoryIcons')?.textContent || '{}');

  let ALL: Biz[] = [];
  // search.json is a list of tuples (see search.json.ts) to keep the download small.
  const FIELDS = ['slug', 'name', 'category', 'googleCategory', 'city', 'state', 'address', 'claimStatus', 'rating', 'reviews', 'price', 'photo', 'lat', 'lng'] as const;
  const STATUS = ['unclaimed', 'pending', 'claimed'] as const;
  let loading: Promise<void> | null = null;
  function load() {
    loading ??= fetch('/businesses/search.json')
      .then((r) => r.json())
      .then((rows: { cats: string[]; rows: unknown[][] }) => {
        ALL = rows.rows.map((r) => {
          const o = Object.fromEntries(FIELDS.map((f, i) => [f, r[i]])) as Record<string, unknown>;
          o.category = rows.cats[o.category as number];
          o.claimStatus = STATUS[o.claimStatus as number];
          o.area = CITY_AREA[`${o.city}, ${o.state}`] ?? o.state;
          return o as unknown as Biz;
        });
        // Listings without coordinates sit at the middle of their city, so "near me" still finds them.
        const sums = new Map<string, [number, number, number]>();
        for (const b of ALL) {
          if (b.lat == null || b.lng == null) continue;
          const k = `${b.city}|${b.state}`;
          const s = sums.get(k) ?? [0, 0, 0];
          sums.set(k, [s[0] + b.lat, s[1] + b.lng, s[2] + 1]);
        }
        for (const b of ALL) {
          const s = b.lat == null || b.lng == null ? sums.get(`${b.city}|${b.state}`) : undefined;
          if (s) [b.lat, b.lng, b.approx] = [s[0] / s[2], s[1] / s[2], true];
        }
      });
    return loading;
  }

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const cityFilter = document.getElementById('cityFilter') as HTMLSelectElement;
  const locateBtn = document.getElementById('locateBtn') as HTMLButtonElement | null;
  const locNote = document.getElementById('locNote') as HTMLParagraphElement | null;
  const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement;
  const pills = [...document.querySelectorAll<HTMLButtonElement>('#categoryPills .pill')];
  const grid = document.getElementById('bizGrid') as HTMLDivElement;
  const resultCount = document.getElementById('resultCount') as HTMLDivElement;
  const loadMore = document.getElementById('loadMore') as HTMLButtonElement;

  let activeCategory = 'All';
  let shown = PAGE;
  let current: Biz[] = [];
  let user: Spot | null = null;
  let elsewhere = 0; // matches for the current search outside the chosen location

  // Search words, loosely: accents and case ignored, plurals reduced ("restaurants" finds "Restaurant",
  // "tacos" finds "Taco"), and filler like "near me" dropped. Every remaining word has to match.
  const ACCENTS = new RegExp(`[${String.fromCharCode(0x300)}-${String.fromCharCode(0x36f)}]`, 'g'); // combining marks after NFD
  const fold = (s: string) => s.normalize('NFD').replace(ACCENTS, '').toLowerCase();
  const STOP = new Set(['near', 'me', 'in', 'the', 'and', 'a', 'of', 'best', 'good', 'places', 'place', 'spots', 'spot', 'food']);
  const stem = (w: string) => (w.length > 4 && /(ies)$/.test(w) ? w.slice(0, -3) + 'y' : w.length > 4 && /(ches|shes|sses|xes)$/.test(w) ? w.slice(0, -2) : w.length > 3 && w.endsWith('s') && !w.endsWith('ss') ? w.slice(0, -1) : w);
  function queryWords(q: string) {
    const all = fold(q).split(/[^a-z0-9$']+/).filter(Boolean);
    const kept = all.filter((w) => !STOP.has(w));
    return (kept.length ? kept : all).map(stem);
  }
  const hay = new WeakMap<Biz, string>();
  function matchesWords(b: Biz, words: string[]) {
    if (!words.length) return true;
    let h = hay.get(b);
    if (h === undefined) hay.set(b, (h = fold(`${b.name} ${b.googleCategory} ${b.category} ${b.address} ${b.city}`)));
    return words.every((w) => h!.includes(w));
  }

  // Typo tolerance: a search word (5+ letters) found in no listing is swapped for the closest word that is,
  // preferring common words ("restuarants" -> "restaurant"). One slip allowed, two for 8+ letter words.
  let vocab: [string, number][] | null = null;
  const spelled = new Map<string, string>(); // stem -> a spelling seen in the listings, for the "showing results for" hint
  function vocabulary() {
    if (vocab) return vocab;
    const counts = new Map<string, number>();
    for (const b of ALL)
      for (const w of fold(`${b.name} ${b.googleCategory} ${b.category} ${b.city}`).split(/[^a-z0-9']+/)) {
        if (w.length < 4) continue;
        const k = stem(w);
        counts.set(k, (counts.get(k) ?? 0) + 1);
        if (!spelled.has(k)) spelled.set(k, w);
      }
    return (vocab = [...counts.entries()]);
  }
  // Edit distance counting swapped neighbours as one slip; gives up early past `max`.
  function editDistance(a: string, b: string, max: number) {
    let prev2: number[] = [];
    let prev = Array.from({ length: b.length + 1 }, (_, j) => j);
    for (let i = 1; i <= a.length; i++) {
      const cur = [i];
      let rowMin = i;
      for (let j = 1; j <= b.length; j++) {
        let d = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + (a[i - 1] === b[j - 1] ? 0 : 1));
        if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) d = Math.min(d, prev2[j - 2] + 1);
        cur[j] = d;
        rowMin = Math.min(rowMin, d);
      }
      if (rowMin > max) return max + 1;
      prev2 = prev;
      prev = cur;
    }
    return prev[b.length];
  }
  const fixes = new Map<string, string>();
  function correct(w: string) {
    if (w.length < 5 || ALL.some((b) => matchesWords(b, [w]))) return w;
    const cached = fixes.get(w);
    if (cached) return cached;
    const max = w.length >= 8 ? 2 : 1;
    let best = w;
    let bestD = max + 1;
    let bestN = 0;
    for (const [v, n] of vocabulary()) {
      if (Math.abs(v.length - w.length) > max) continue;
      const d = editDistance(w, v, max);
      if (d < bestD || (d === bestD && n > bestN)) [best, bestD, bestN] = [v, d, n];
    }
    fixes.set(w, best);
    return best;
  }

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  // Rating weighted by review volume, so a 5.0 with 3 reviews doesn't outrank a 4.6 with 2,000.
  const popularity = (b: Biz) => (b.claimStatus === 'claimed' ? 100 : 0) + (b.rating ? b.rating * Math.log10(b.reviews + 10) : 0);

  function km(b: Biz) {
    if (!user || b.lat == null || b.lng == null) return Infinity;
    const rad = Math.PI / 180;
    const dLat = (b.lat - user.lat) * rad;
    const dLng = (b.lng - user.lng) * rad;
    const h = Math.sin(dLat / 2) ** 2 + Math.cos(user.lat * rad) * Math.cos(b.lat * rad) * Math.sin(dLng / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(h));
  }
  // Listings placed at their city's middle go after ones with a real position.
  const nearest = (b: Biz) => km(b) + (b.approx ? 8 : 0);
  // Recommended, once we know where the visitor is: popularity, gently discounted by distance.
  const recommended = (b: Biz) => {
    const d = km(b);
    return d === Infinity ? popularity(b) : popularity(b) / (1 + d / 8);
  };

  // --- location -------------------------------------------------------------------------------------------
  const locLabel = (v: string) =>
    v === 'near' ? (user?.precise ? 'you' : user?.label ?? 'you') : v.startsWith('area:') ? areaLabel(v.slice(5)) : v;
  const areaLabel = (name: string) => {
    const a = AREAS.find((x) => x.name === name);
    return a ? `${a.name}, ${a.state}` : name;
  };

  function setNearOption() {
    let opt = cityFilter.querySelector<HTMLOptionElement>('option[value="near"]');
    if (!user) return opt?.remove();
    if (!opt) {
      opt = document.createElement('option');
      opt.value = 'near';
      cityFilter.options[0].after(opt); // right after "All areas" (the other options sit inside state optgroups)
    }
    opt.textContent = user.precise ? 'Near me' : `Near ${user.label}`;
    // "Nearest" only makes sense with a location; with an IP guess it is city-level, so keep it to precise fixes.
    let byDist = sortSelect.querySelector<HTMLOptionElement>('option[value="nearest"]');
    if (user.precise && !byDist) {
      byDist = document.createElement('option');
      byDist.value = 'nearest';
      byDist.textContent = 'Nearest';
      sortSelect.insertBefore(byDist, sortSelect.options[1] ?? null);
    }
  }

  function note(html: string) {
    if (!locNote) return;
    locNote.innerHTML = html;
    locNote.hidden = !html;
  }

  function save() {
    try {
      localStorage.setItem(SAVE_KEY, JSON.stringify({ loc: cityFilter.value, user }));
    } catch {}
  }
  function restore(): { loc: string; user: Spot | null } | null {
    try {
      return JSON.parse(localStorage.getItem(SAVE_KEY) || 'null');
    } catch {
      return null;
    }
  }

  // Pick "near" when the visitor is close to any listing, otherwise show every area grouped by state.
  async function useSpot(spot: Spot) {
    user = spot;
    setNearOption();
    await load();
    const nearest = Math.min(...ALL.map(km));
    if (nearest <= SERVED_KM) {
      cityFilter.value = 'near';
      note(`<i class="ti ti-map-pin"></i> Showing spots near ${esc(locLabel('near'))} · <button type="button" data-act="all">See all areas</button>`);
    } else {
      cityFilter.value = '';
      if (sortSelect.value === 'nearest') sortSelect.value = 'popular';
      const where = spot.precise ? 'your area' : esc(spot.label);
      note(`GOTYOU isn’t in ${where} yet. Here’s what’s popular where we are.`);
    }
  }

  locNote?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-act="all"]')) {
      cityFilter.value = '';
      note('');
      save();
      apply();
    }
  });

  locateBtn?.addEventListener('click', () => {
    if (!navigator.geolocation) return note('Your browser can’t share your location. Pick an area above — search works either way.');
    locateBtn.classList.add('busy');
    navigator.geolocation.getCurrentPosition(
      async (p) => {
        locateBtn.classList.remove('busy');
        await useSpot({ lat: p.coords.latitude, lng: p.coords.longitude, precise: true, label: 'you' });
        if (cityFilter.value === 'near') sortSelect.value = 'nearest';
        save();
        apply();
      },
      (err) => {
        locateBtn.classList.remove('busy');
        note(
          err.code === err.PERMISSION_DENIED
            ? 'Location is turned off for this site. Pick an area above — search works either way.'
            : 'We couldn’t pin down your location. Pick an area above — search works either way.',
        );
      },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 60000 },
    );
  });

  // --- rendering ------------------------------------------------------------------------------------------
  function card(b: Biz) {
    const icon = ICONS[b.category] ?? 'ti-building-store';
    const photo = b.photo
      ? `<img src="${esc(b.photo)}" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.remove()">`
      : '';
    const badge =
      b.claimStatus === 'claimed'
        ? '<span class="badge badge--on"><i class="ti ti-circle-check-filled"></i> On GOTYOU</span>'
        : '';
    const rating = b.rating
      ? `<span class="rating"><i class="ti ti-star-filled"></i>${b.rating.toFixed(1)}<span class="cnt">(${b.reviews.toLocaleString()})</span></span>`
      : '<span class="rating rating--none">No reviews yet</span>';
    const d = user?.precise && !b.approx ? km(b) : Infinity;
    const mi = d / 1.609;
    const where = d < 160 ? `${esc(b.city)} · ${mi < 0.1 ? '&lt;0.1' : mi.toFixed(mi < 10 ? 1 : 0)} mi` : esc(b.city);
    return `
      <a href="/businesses/${b.slug}" class="card">
        <div class="photo"><span class="ph"><i class="ti ${icon}"></i></span>${photo}
          <span class="chip"><i class="ti ${icon}"></i>${esc(b.category)}</span>${badge}
        </div>
        <div class="body">
          <h3>${esc(b.name)}</h3>
          <div class="sub">${esc(b.googleCategory)}${b.price ? ` · ${esc(b.price)}` : ''}</div>
          <div class="foot">${rating}<span class="loc"><i class="ti ti-map-pin"></i>${where}</span></div>
        </div>
      </a>`;
  }

  const plural = (n: number) => `<strong>${n.toLocaleString()}</strong> ${n === 1 ? 'place' : 'places'}`;

  // No location chosen: the top spots in each area, grouped by state, nearest area first when we know where the visitor is.
  function renderGrouped() {
    const groups = AREAS.map((a) => ({ a, items: current.filter((b) => b.area === a.name) })).filter((g) => g.items.length);
    if (user) groups.sort((x, y) => Math.min(...x.items.map(km)) - Math.min(...y.items.map(km)));
    resultCount.innerHTML = `${plural(current.length)} in ${groups.length} ${groups.length === 1 ? 'area' : 'areas'}`;
    grid.classList.add('grouped');
    loadMore.hidden = true;
    grid.innerHTML = groups
      .map(
        ({ a, items }) => `
        <section class="group">
          <div class="group-head">
            <div><span class="group-state">${esc(a.stateName)}</span><h2>Popular in ${esc(a.name)}, ${esc(a.state)}</h2></div>
            <a class="see-all" href="?city=${encodeURIComponent(`area:${a.name}`)}" data-loc="${esc(`area:${a.name}`)}">See all ${items.length.toLocaleString()} <i class="ti ti-arrow-right"></i></a>
          </div>
          <div class="group-grid">${items.slice(0, GROUP).map(card).join('')}</div>
        </section>`,
      )
      .join('');
  }

  function render() {
    if (!current.length) {
      const v = cityFilter.value;
      resultCount.innerHTML = `${plural(0)}${v ? ` ${v === 'near' ? 'near' : 'in'} ${esc(locLabel(v))}` : ''}`;
      grid.classList.remove('grouped');
      // Matches exist outside the chosen location: offer them instead of a dead end.
      const widen = v && elsewhere
        ? `<button type="button" class="reset reset--primary" id="widenSearch">See ${plural(elsewhere)} in all areas</button>`
        : '';
      grid.innerHTML = `<div class="empty"><i class="ti ti-mood-search"></i><p>Nothing matches that${v ? ` in ${esc(locLabel(v))}` : ''} yet.</p>
        ${widen}<button type="button" class="reset" id="resetFilters">Clear search</button></div>`;
      document.getElementById('resetFilters')?.addEventListener('click', reset);
      document.getElementById('widenSearch')?.addEventListener('click', () => {
        cityFilter.value = '';
        note('');
        save();
        apply();
      });
      loadMore.hidden = true;
      return;
    }
    if (!cityFilter.value) return renderGrouped();
    const v = cityFilter.value;
    resultCount.innerHTML = `${plural(current.length)} ${v === 'near' ? 'near' : 'in'} ${esc(locLabel(v))}`;
    grid.classList.remove('grouped');
    grid.innerHTML = current.slice(0, shown).map(card).join('');
    loadMore.hidden = shown >= current.length;
    loadMore.textContent = `Show more (${(current.length - shown).toLocaleString()} left)`;
  }

  async function apply(resetPaging = true) {
    if (!ALL.length) {
      grid.setAttribute('aria-busy', 'true');
      await load();
      grid.removeAttribute('aria-busy');
    }
    const typed = queryWords(searchInput.value);
    const words = typed.map(correct);
    const fixed = words.some((w, i) => w !== typed[i]) ? words.map((w) => spelled.get(w) ?? w).join(' ') : '';
    const v = cityFilter.value;
    const inLocation =
      v === 'near' ? (b: Biz) => km(b) <= NEAR_KM : v.startsWith('area:') ? (b: Biz) => b.area === v.slice(5) : v ? (b: Biz) => `${b.city}, ${b.state}` === v : () => true;
    const matches = ALL.filter((b) => matchesWords(b, words) && (activeCategory === 'All' || b.category === activeCategory));
    current = matches.filter(inLocation);
    elsewhere = matches.length - current.length;
    const sort = sortSelect.value;
    current.sort((a, b) =>
      sort === 'name'
        ? a.name.localeCompare(b.name)
        : sort === 'rating'
          ? b.rating - a.rating || b.reviews - a.reviews
          : sort === 'nearest'
            ? nearest(a) - nearest(b)
            : recommended(b) - recommended(a),
    );
    if (resetPaging) shown = PAGE;
    render();
    if (fixed) resultCount.insertAdjacentHTML('beforeend', ` <span class="fixed">· showing results for <strong>${esc(fixed)}</strong></span>`);
    syncUrl();
  }

  function setCategory(cat: string) {
    activeCategory = pills.some((p) => p.dataset.cat === cat) ? cat : 'All';
    pills.forEach((p) => {
      const on = p.dataset.cat === activeCategory;
      p.classList.toggle('active', on);
      p.setAttribute('aria-pressed', String(on));
    });
  }

  function syncUrl() {
    const p = new URLSearchParams();
    if (searchInput.value.trim()) p.set('q', searchInput.value.trim());
    // "near" is personal (it depends on where the visitor is), so it isn't put in shareable links.
    if (cityFilter.value && cityFilter.value !== 'near') p.set('city', cityFilter.value);
    if (activeCategory !== 'All') p.set('cat', activeCategory);
    if (sortSelect.value !== 'popular') p.set('sort', sortSelect.value);
    const qs = p.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  }

  function reset() {
    searchInput.value = '';
    setCategory('All');
    apply();
  }

  let t: number | undefined;
  searchInput.addEventListener('input', () => {
    clearTimeout(t);
    t = window.setTimeout(() => apply(), 120);
  });
  cityFilter.addEventListener('change', () => {
    note('');
    if (sortSelect.value === 'nearest' && cityFilter.value !== 'near') sortSelect.value = 'popular';
    save();
    apply();
  });
  sortSelect.addEventListener('change', () => apply());
  pills.forEach((p) => p.addEventListener('click', () => (setCategory(p.dataset.cat || 'All'), apply())));
  grid.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-loc]');
    if (!link) return;
    e.preventDefault();
    cityFilter.value = link.dataset.loc!;
    note('');
    save();
    apply();
    document.querySelector('.dir-body')?.scrollIntoView({ behavior: 'smooth' });
  });
  loadMore.addEventListener('click', async () => {
    if (!ALL.length) await apply();
    shown += PAGE;
    render();
  });

  // --- start-up -------------------------------------------------------------------------------------------
  // Order: filters in the URL, then the visitor's last choice, then Cloudflare's IP location.
  // The server already rendered the grouped view, so nothing is re-rendered unless one of these changes it.
  async function start() {
    const params = new URLSearchParams(location.search);
    searchInput.value = params.get('q') ?? '';
    if ([...sortSelect.options].some((o) => o.value === params.get('sort'))) sortSelect.value = params.get('sort')!;
    setCategory(params.get('cat') ?? 'All');
    const hasOption = (v: string | null) => v != null && [...cityFilter.options].some((o) => o.value === v);

    const saved = restore();
    if (saved?.user) {
      user = saved.user;
      setNearOption();
    }
    if (hasOption(params.get('city'))) {
      cityFilter.value = params.get('city')!;
      return apply();
    }
    if (saved && (hasOption(saved.loc) || saved.loc === '')) {
      cityFilter.value = saved.loc;
      if (saved.loc === 'near') note(`<i class="ti ti-map-pin"></i> Showing spots near ${esc(locLabel('near'))} · <button type="button" data-act="all">See all areas</button>`);
      return saved.loc || user || params.toString() ? apply() : load();
    }
    try {
      const g = await (await fetch('/api/geo')).json();
      if (typeof g.lat === 'number' && typeof g.lng === 'number') {
        const label = g.city ? `${g.city}${g.region && g.country === 'US' ? `, ${g.region}` : ''}` : 'you';
        await useSpot({ lat: g.lat, lng: g.lng, precise: false, label });
        return apply();
      }
    } catch {}
    return params.toString() ? apply() : load();
  }
  start();
</script>

