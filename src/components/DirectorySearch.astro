---
// This is the one genuinely interactive piece of the directory. Rather than
// pulling in a UI framework for a search box + filter pills, this ships the
// pre-built search index as inline JSON and filters with vanilla JS. At a
// few thousand businesses the whole index is still well under what's
// reasonable to ship as a static <script> payload — if the directory grows
// past ~20k businesses, swap this for a Cloudflare Worker search endpoint
// instead of filtering client-side (see SKILL notes in scripts/README.md).
interface BusinessSearchEntry {
  slug: string;
  name: string;
  category: string;
  city: string;
  address: string;
  claimStatus: 'unclaimed' | 'pending' | 'claimed';
  checkinCount: number;
}

interface Props {
  businesses: BusinessSearchEntry[];
  cities: string[];
}

const { businesses, cities } = Astro.props;
const categories = ['All', ...new Set(businesses.map((b) => b.category))].sort();
---

<div class="section" style="padding-top: 0;">
  <div class="section-inner">
    <div class="controls">
      <input type="text" id="searchInput" placeholder="Search business name or category..." />
      <select id="cityFilter">
        <option value="">All Cities</option>
        {cities.map((c) => <option value={c}>{c}</option>)}
      </select>
    </div>
    <div class="pills" id="categoryPills">
      {categories.map((c) => (
        <button class:list={['pill', c === 'All' && 'active']} data-cat={c}>{c}</button>
      ))}
    </div>
    <div class="result-count" id="resultCount"></div>
    <div class="grid" id="bizGrid"></div>
  </div>
</div>

<script type="application/json" id="businessData" set:html={JSON.stringify(businesses)} />

<script>
  type BusinessSearchEntry = {
    slug: string;
    name: string;
    category: string;
    city: string;
    address: string;
    claimStatus: 'unclaimed' | 'pending' | 'claimed';
    checkinCount: number;
  };

  const dataEl = document.getElementById('businessData');
  const ALL_BUSINESSES: BusinessSearchEntry[] = JSON.parse(dataEl?.textContent || '[]');

  const searchInput = document.getElementById('searchInput') as HTMLInputElement;
  const cityFilter = document.getElementById('cityFilter') as HTMLSelectElement;
  const pillsContainer = document.getElementById('categoryPills') as HTMLDivElement;
  const grid = document.getElementById('bizGrid') as HTMLDivElement;
  const resultCount = document.getElementById('resultCount') as HTMLDivElement;

  let activeCategory = 'All';

  function statusBadgeHtml(status: BusinessSearchEntry['claimStatus']) {
    if (status === 'claimed') return '<div class="biz-badge"><i class="ti ti-check"></i> Verified</div>';
    if (status === 'pending') return '<div class="biz-badge" style="border-color: rgba(245,197,24,0.4); color: var(--yellow);"><i class="ti ti-clock"></i> In Review</div>';
    return '<div class="biz-badge" style="border-color: rgba(255,255,255,0.2); color: var(--text-dim);"><i class="ti ti-alert-circle"></i> Unclaimed</div>';
  }

  function render(list: BusinessSearchEntry[]) {
    resultCount.textContent = `${list.length} business${list.length === 1 ? '' : 'es'} found`;

    if (!list.length) {
      grid.innerHTML = `<div class="empty"><i class="ti ti-search"></i><p>No businesses found. Try a different search.</p></div>`;
      return;
    }

    grid.innerHTML = list
      .map(
        (b) => `
        <a href="/businesses/${b.slug}" class="biz-card">
          <div class="biz-img" style="background: var(--card-light); display:flex; align-items:center; justify-content:center;">
            <i class="ti ti-building-store" style="font-size: 34px; color: rgba(255,255,255,.15);"></i>
            ${statusBadgeHtml(b.claimStatus)}
          </div>
          <div class="biz-body">
            <h4>${b.name}</h4>
            <div class="cat">${b.category} · ${b.city}</div>
            <div class="biz-foot">
              <div class="checkins"><i class="ti ti-map-pin"></i> ${b.address}</div>
            </div>
            ${b.checkinCount > 0 ? `<div class="biz-foot" style="margin-top: 6px;"><div class="checkins"><i class="ti ti-map-check"></i> ${b.checkinCount} check-ins</div></div>` : ''}
          </div>
        </a>`
      )
      .join('');
  }

  function filter() {
    const q = searchInput.value.toLowerCase().trim();
    const city = cityFilter.value;

    const filtered = ALL_BUSINESSES.filter((b) => {
      const matchesQuery = !q || b.name.toLowerCase().includes(q) || b.category.toLowerCase().includes(q);
      const matchesCity = !city || b.city === city;
      const matchesCategory = activeCategory === 'All' || b.category === activeCategory;
      return matchesQuery && matchesCity && matchesCategory;
    });

    render(filtered);
  }

  searchInput.addEventListener('input', filter);
  cityFilter.addEventListener('change', filter);

  pillsContainer.querySelectorAll<HTMLButtonElement>('.pill').forEach((pill) => {
    pill.addEventListener('click', () => {
      activeCategory = pill.dataset.cat || 'All';
      pillsContainer.querySelectorAll('.pill').forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');
      filter();
    });
  });

  // Initial render — runs once on page load with the full unfiltered list
  filter();
</script>

<style>
  .controls {
    display: flex;
    gap: 0;
    max-width: 580px;
    margin: 0 auto 1.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .controls input {
    flex: 1;
    padding: 16px 20px;
    border: none;
    font-size: 15px;
    font-family: var(--font-body);
    outline: none;
    background: var(--card);
    color: var(--text);
  }
  .controls input::placeholder {
    color: var(--text-dimmer);
  }
  .controls select {
    padding: 16px 14px;
    border: none;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 14px;
    font-family: var(--font-body);
    outline: none;
    background: var(--card-light);
    color: var(--text-dim);
    cursor: pointer;
  }

  .pills {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
    justify-content: center;
  }
  .pill {
    padding: 6px 16px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: var(--card);
    font-size: 13px;
    cursor: pointer;
    color: var(--text-dim);
    transition: all 0.2s;
    font-family: var(--font-body);
  }
  .pill.active,
  .pill:hover {
    background: var(--blue-bright);
    color: #fff;
    border-color: var(--blue-bright);
  }

  .result-count {
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 1rem;
    text-align: center;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.4rem;
  }

  .grid :global(.biz-card:hover) {
    transform: translateY(-4px);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 3rem;
    color: var(--text-dim);
  }
  .empty i {
    font-size: 40px;
    margin-bottom: 1rem;
    display: block;
    opacity: 0.3;
  }
</style>
