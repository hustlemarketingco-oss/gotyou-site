---
// Shared layout for /explore landing pages ("Best Sushi in Provo", "Pizza Deals in Provo", ...).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import SpotList from './SpotList.astro';
import type { Biz } from '../lib/profile-content';

interface LinkGroup {
  title: string;
  links: { href: string; label: string; count?: number }[];
}
interface Props {
  title: string; // <title> and H1 text
  heading: string; // H1 html (may contain <em>)
  eyebrow: string;
  intro: string;
  metaDescription?: string;
  listTitle: string;
  items: Biz[];
  notes?: (string | undefined)[];
  faqs: { q: string; a: string }[];
  breadcrumbs: { name: string; href: string }[];
  related: LinkGroup[];
}
const { title, heading, eyebrow, intro, metaDescription, listTitle, items, notes, faqs, breadcrumbs, related } = Astro.props;
const site = Astro.site ?? Astro.url;
const abs = (p: string) => new URL(p, site).href;
const ld = [
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: abs(c.href) })) },
  { '@context': 'https://schema.org', '@type': 'ItemList', name: title, numberOfItems: items.length, itemListElement: items.map((b, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/businesses/${b.slug}/`), name: b.name })) },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<BaseLayout title={title} description={(metaDescription ?? intro).slice(0, 300)}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <PageHero eyebrow={eyebrow} title={heading} lede={intro}>
    <nav class="crumbs" aria-label="Breadcrumb">
      {breadcrumbs.slice(0, -1).map((c) => <><a href={c.href}>{c.name}</a> › </>)}<span>{breadcrumbs[breadcrumbs.length - 1].name}</span>
    </nav>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <div>
        <slot name="before" />
        <h2 class="h3 sec-title">{listTitle}</h2>
        <SpotList items={items} notes={notes} />
        <slot />
        <section class="faq">
          <h2 class="h3 sec-title">Quick answers</h2>
          {faqs.map((f) => <details><summary>{f.q}<i class="ti ti-plus"></i></summary><p>{f.a}</p></details>)}
        </section>
      </div>
      <aside>
        {related.filter((g) => g.links.length).map((g) => (
          <div class="card card--pad side">
            <h2>{g.title}</h2>
            <ul>{g.links.map((l) => <li><a href={l.href}>{l.label}</a>{l.count !== undefined && <small>{l.count}</small>}</li>)}</ul>
          </div>
        ))}
        <div class="card card--pad side">
          <h2>Own one of these?</h2>
          <p>Claim your free listing to keep your hours and details accurate — and send offers to locals nearby.</p>
          <a href="/solution/" class="link-arrow">For business <i class="ti ti-arrow-right"></i></a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .crumbs {
    margin-top: 18px;
    font-size: 14px;
    opacity: 0.92;
  }
  .crumbs a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 36px;
    align-items: start;
  }
  .sec-title {
    margin-bottom: 16px;
  }
  .faq {
    margin-top: 48px;
  }
  .faq details {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 2px 20px;
    margin-bottom: 10px;
  }
  .faq summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    gap: 14px;
    font-weight: 600;
    padding: 14px 0;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary i {
    color: var(--blue);
  }
  .faq details p {
    color: var(--muted);
    padding-bottom: 14px;
  }
  .side {
    margin-bottom: 18px;
  }
  .side h2 {
    font-size: 18px;
    margin-bottom: 12px;
  }
  .side p {
    color: var(--muted);
    margin-bottom: 10px;
  }
  .side ul {
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .side li {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .side li a {
    color: var(--blue);
    font-weight: 500;
  }
  .side small {
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
</style>
