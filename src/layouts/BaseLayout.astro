---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
// Self-hosted fonts and icons: no render-blocking requests to Google Fonts or the icon CDN.
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-600.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/poppins/latin-800.css';
import '../styles/icons.css';
// Preload the two Poppins files above-the-fold text uses (800 headings, 400 body) so the
// headline (the LCP element) doesn't wait on CSS discovery.
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import '../styles/global.css';
import { IS_PREVIEW } from '../lib/deploy';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = 'GOTYOU is the daily match between locals and the businesses near them — and it pays you real cash for showing up.',
  ogImage = '/images/site/og-gotyou.jpg',
  noindex = false,
} = Astro.props;

const fullTitle = title === 'GOTYOU' ? title : `${title} | GOTYOU`;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1f6bd6" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || IS_PREVIEW) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={poppins800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={poppins400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/tabler-subset.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={Astro.url.href} />
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      // Fade-up for .reveal elements as they scroll into view.
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => e.isIntersecting && (e.target.classList.add('is-in'), io.unobserve(e.target))),
          { rootMargin: '0px 0px -8% 0px' },
        );
        const watch = () => document.querySelectorAll('.reveal:not(.is-in)').forEach((el) => io.observe(el));
        watch();
        document.addEventListener('reveal:refresh', watch);
      }
    </script>
  </body>
</html>
